SimDiamond.reach_iff_diamond {b : SimDiamond.Bounds} {c : SimDiamond.Cell} (hc : SimDiamond.Legal b c) (r : Nat)
  (p : SimDiamond.Cell) : SimDiamond.ReachWithin b c r p ↔ SimDiamond.Legal b p ∧ SimDiamond.manhattan c p < r
SimDiamond.bfs_checkedScan_same_cells (b : SimDiamond.Bounds) (c : SimDiamond.Cell) (r : Nat) (p : SimDiamond.Cell) :
  p ∈ SimDiamond.bfs b c r ↔ p ∈ SimDiamond.checkedScan b c r
SimDiamond.bfs_checkedScan_same_updates {Value : Type} (b : SimDiamond.Bounds) (c : SimDiamond.Cell) (r : Nat)
  (update : SimDiamond.Cell → Value → Value) (state : SimDiamond.Cell → Value) :
  SimDiamond.runUpdates update (SimDiamond.bfs b c r) state =
    SimDiamond.runUpdates update (SimDiamond.checkedScan b c r) state
SimDiamond.linearIndex_injective (stride : Int) (p q : SimDiamond.Cell) (hpx : 0 ≤ p.x) (hpxw : p.x < stride)
  (hqx : 0 ≤ q.x) (hqxw : q.x < stride) (heq : SimDiamond.linearIndex stride p = SimDiamond.linearIndex stride q) :
  p = q
