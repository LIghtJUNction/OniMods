msgstr "该操作仅允许星系主人执行"

#. STRINGS.ONIONLINE.ERROR.CHAT_RATE_LIMITED
msgctxt "STRINGS.ONIONLINE.ERROR.CHAT_RATE_LIMITED"
msgid "Chat rate limit exceeded"
msgstr "消息发送过快"

#. STRINGS.ONIONLINE.ERROR.INVALID_CHAT_OR_RATE
msgctxt "STRINGS.ONIONLINE.ERROR.INVALID_CHAT_OR_RATE"
msgid "Message is empty or too long or sent too quickly"
msgstr "消息为空或过长或发送太快"

#. STRINGS.ONIONLINE.ERROR.ALREADY_CONNECTED
msgctxt "STRINGS.ONIONLINE.ERROR.ALREADY_CONNECTED"
msgid "Leave the current system first"
msgstr "请先离开当前星系"

#. STRINGS.ONIONLINE.ERROR.ALREADY_IN_GAME
msgctxt "STRINGS.ONIONLINE.ERROR.ALREADY_IN_GAME"
msgid "A colony is already running; it will not be replaced automatically"
msgstr "已有殖民地正在运行；不会自动切换存档"

#. STRINGS.ONIONLINE.ERROR.CONNECT_FAILED
msgctxt "STRINGS.ONIONLINE.ERROR.CONNECT_FAILED"
msgid "Could not connect; check the address and firewall"
msgstr "无法连接星系；请检查地址与防火墙"

#. STRINGS.ONIONLINE.ERROR.LISTEN_FAILED
msgctxt "STRINGS.ONIONLINE.ERROR.LISTEN_FAILED"
msgid "System listener failed"
msgstr "星系监听失败"

#. STRINGS.ONIONLINE.ERROR.HOST_DISCONNECTED
msgctxt "STRINGS.ONIONLINE.ERROR.HOST_DISCONNECTED"
msgid "Connection to the host was lost"
msgstr "与星系主人的连接已断开"

#. STRINGS.ONIONLINE.ERROR.RECONNECTING
msgctxt "STRINGS.ONIONLINE.ERROR.RECONNECTING"
msgid "Connection interrupted; reconnecting"
msgstr "连接中断，正在重新连接"

#. STRINGS.ONIONLINE.ERROR.RECONNECT_EXPIRED
msgctxt "STRINGS.ONIONLINE.ERROR.RECONNECT_EXPIRED"
msgid "Reconnect timed out; join the system again"
msgstr "重新连接超时，请重新加入星系"

#. STRINGS.ONIONLINE.ERROR.RESUME_INVALID
msgctxt "STRINGS.ONIONLINE.ERROR.RESUME_INVALID"
msgid "Could not restore the connection; join the system again"
msgstr "无法恢复原来的连接，请重新加入星系"

#. STRINGS.ONIONLINE.ERROR.HOST_LEFT
msgctxt "STRINGS.ONIONLINE.ERROR.HOST_LEFT"
msgid "The host has left the system"
msgstr "星系主人已离开星系"

#. STRINGS.ONIONLINE.ERROR.HOST_CHANGED
msgctxt "STRINGS.ONIONLINE.ERROR.HOST_CHANGED"
msgid "The host has changed; join the system again"
msgstr "星系主人已变更，请重新加入星系"

#. STRINGS.ONIONLINE.ERROR.CHAT_QUEUE_FULL
msgctxt "STRINGS.ONIONLINE.ERROR.CHAT_QUEUE_FULL"
msgid "Too many pending messages; wait for the connection to recover"
msgstr "待发送消息过多，请等待网络恢复"

#. STRINGS.ONIONLINE.ERROR.CHAT_DELIVERY_FAILED
msgctxt "STRINGS.ONIONLINE.ERROR.CHAT_DELIVERY_FAILED"
msgid "Message could not be delivered"
msgstr "消息未能送达"

#. STRINGS.ONIONLINE.ERROR.CHAT_HISTORY_EXPIRED
msgctxt "STRINGS.ONIONLINE.ERROR.CHAT_HISTORY_EXPIRED"
msgid "Some messages sent while disconnected are no longer available"
msgstr "断线期间的部分消息已无法恢复"

#. STRINGS.ONIONLINE.ERROR.CONNECTION_CLOSED
msgctxt "STRINGS.ONIONLINE.ERROR.CONNECTION_CLOSED"
msgid "Connection closed"
msgstr "连接已关闭"

#. STRINGS.ONIONLINE.ERROR.NETWORK_FAILED
msgctxt "STRINGS.ONIONLINE.ERROR.NETWORK_FAILED"
msgid "Network operation failed; check connection settings"
msgstr "网络操作失败；请检查连接设置"

#. STRINGS.ONIONLINE.ERROR.STEAM_UNAVAILABLE
msgctxt "STRINGS.ONIONLINE.ERROR.STEAM_UNAVAILABLE"
msgid "Steam networking is unavailable; LAN direct connection is available"
msgstr "Steam 联机接口不可用；可尝试局域网直连"

#. STRINGS.ONIONLINE.ERROR.STEAM_SEND_FAILED
msgctxt "STRINGS.ONIONLINE.ERROR.STEAM_SEND_FAILED"
msgid "Steam message delivery failed"
msgstr "Steam 消息发送失败"

#. STRINGS.ONIONLINE.ERROR.STEAM_LOBBY_FAILED
msgctxt "STRINGS.ONIONLINE.ERROR.STEAM_LOBBY_FAILED"
msgid "Steam system operation failed"
msgstr "Steam 星系操作失败"

#. STRINGS.ONIONLINE.ERROR.LAN_DISCOVERY_UNAVAILABLE
msgctxt "STRINGS.ONIONLINE.ERROR.LAN_DISCOVERY_UNAVAILABLE"
msgid "LAN discovery unavailable; direct system-code connection still works"
msgstr "局域网发现不可用；仍可复制星系码直连"

#. STRINGS.ONIONLINE.ERROR.DEPENDENCIES_REQUIRED
msgctxt "STRINGS.ONIONLINE.ERROR.DEPENDENCIES_REQUIRED"
msgid "A valid player name and active CycleTrim and Spaced Out! are required"
msgstr "需要有效玩家名并启用 CycleTrim 与眼冒金星"

#. STRINGS.ONIONLINE.TIME.LOCAL_PAUSE
msgctxt "STRINGS.ONIONLINE.TIME.LOCAL_PAUSE"
msgid "Release local pause before voting"
msgstr "先解除本地暂停，再同意恢复"

#. STRINGS.ONIONLINE.UI.PLAYER_OFFLINE
msgctxt "STRINGS.ONIONLINE.UI.PLAYER_OFFLINE"
msgid "Offline"
msgstr "离线"

#. STRINGS.ONIONLINE.ROOM.PUBLIC_STEAM
msgctxt "STRINGS.ONIONLINE.ROOM.PUBLIC_STEAM"
msgid "Public lobbies"
msgstr "公开星系"

#. STRINGS.ONIONLINE.ROOM.WAITING
msgctxt "STRINGS.ONIONLINE.ROOM.WAITING"
msgid "Waiting"
msgstr "等待中"

#. STRINGS.ONIONLINE.ROOM.IN_PROGRESS
msgctxt "STRINGS.ONIONLINE.ROOM.IN_PROGRESS"
msgid "In progress"
msgstr "游戏中"

#. STRINGS.ONIONLINE.ROOM.JOIN_RUNNING
msgctxt "STRINGS.ONIONLINE.ROOM.JOIN_RUNNING"
msgid "Join game"
msgstr "中途加入"

#. STRINGS.ONIONLINE.ROOM.FULL
msgctxt "STRINGS.ONIONLINE.ROOM.FULL"
msgid "Full"
msgstr "已满员"

#. STRINGS.ONIONLINE.SYSTEM.HOME
msgctxt "STRINGS.ONIONLINE.SYSTEM.HOME"
msgid "My star system"
msgstr "我的星系"

#. STRINGS.ONIONLINE.SYSTEM.DEFAULT_NAME
msgctxt "STRINGS.ONIONLINE.SYSTEM.DEFAULT_NAME"
msgid "{0}'s System"
msgstr "{0}'s 星系"

#. STRINGS.ONIONLINE.SYSTEM.MAP
msgctxt "STRINGS.ONIONLINE.SYSTEM.MAP"
msgid "Systems and travel"
msgstr "星系与旅行"

#. STRINGS.ONIONLINE.SYSTEM.OPEN
msgctxt "STRINGS.ONIONLINE.SYSTEM.OPEN"
msgid "Open my star system"
msgstr "开放我的星系"

#. STRINGS.ONIONLINE.SYSTEM.BROWSE
msgctxt "STRINGS.ONIONLINE.SYSTEM.BROWSE"
msgid "Find other star systems"
msgstr "寻找其他星系"

#. STRINGS.ONIONLINE.SYSTEM.CHAT
msgctxt "STRINGS.ONIONLINE.SYSTEM.CHAT"
msgid "Communications"
msgstr "通讯"

#. STRINGS.ONIONLINE.SYSTEM.OFFLINE
msgctxt "STRINGS.ONIONLINE.SYSTEM.OFFLINE"
msgid "You are home. Your colony continues without opening a system."
msgstr "现在是自己的星系。不开房也能继续生活。"

#. STRINGS.ONIONLINE.TIME.INDEPENDENT
msgctxt "STRINGS.ONIONLINE.TIME.INDEPENDENT"
msgid "Each asteroid runs and pauses independently"
msgstr "各星球独立暂停与推进"

#. STRINGS.ONIONLINE.ENGINE.TITLE
msgctxt "STRINGS.ONIONLINE.ENGINE.TITLE"
msgid "Planetary Engine"
msgstr "行星发动机"

#. STRINGS.ONIONLINE.ENGINE.TOOLTIP
msgctxt "STRINGS.ONIONLINE.ENGINE.TOOLTIP"
msgid "Read the Planetary Engine article in the in-game database."
msgstr "在游戏数据库中阅读行星发动机条目。"

#. STRINGS.ONIONLINE.ENGINE.STORY
msgctxt "STRINGS.ONIONLINE.ENGINE.STORY"
msgid "A folded page is tucked inside the printing pod manual. It reads: \"This device may also be used to adjust planetary position.\" The fine print says: \"Please remain inside the planet.\""
msgstr "打印舱的使用手册里夹着一页折起来的说明书。展开后，上面写着：“本设备亦可用于调整行星位置。”下方有一行小字：请勿在行星外侧站立。"

#. STRINGS.ONIONLINE.ENGINE.PREVIEW
msgctxt "STRINGS.ONIONLINE.ENGINE.PREVIEW"
msgid "Communicate with system members and share explored regions. Each player manages their own planet."
msgstr "与星系成员通讯，并共享已探索区域。每位玩家经营自己的星球。"

#. STRINGS.ONIONLINE.ENGINE.CHART_HELP
msgctxt "STRINGS.ONIONLINE.ENGINE.CHART_HELP"
msgid "To create or browse systems use the multiplayer entry in the native star map. This article is informational and does not consume a Printing Pod reward."
msgstr "需要创建或浏览大厅时，请打开原生星图中的联机入口。这个条目只提供说明，不消耗打印机会。"

#. STRINGS.ONIONLINE.OPTIONS.PREFER_STEAM
msgctxt "STRINGS.ONIONLINE.OPTIONS.PREFER_STEAM"
msgid "Prefer Steam public systems"
msgstr "优先显示 Steam 公开星系"

#. STRINGS.ONIONLINE.OPTIONS.PREFER_STEAM_HINT
msgctxt "STRINGS.ONIONLINE.OPTIONS.PREFER_STEAM_HINT"
msgid "Prefer Steam discovery at startup. Disable to default to LAN; manual switching remains available."
msgstr "启动时优先使用 Steam 发现公开星系。关闭后默认使用局域网；仍可手动切换。"

#. STRINGS.ONIONLINE.OPTIONS.LAN_PORT
msgctxt "STRINGS.ONIONLINE.OPTIONS.LAN_PORT"
msgid "Default LAN port"
msgstr "默认局域网端口"

#. STRINGS.ONIONLINE.OPTIONS.LAN_PORT_HINT
msgctxt "STRINGS.ONIONLINE.OPTIONS.LAN_PORT_HINT"
msgid "Initial hosting port (1–65535). The system can override it. Requires a game restart."
msgstr "新启动游戏时的开房端口（1–65535）。星系内仍可单独修改；重启后生效。"

#. STRINGS.ONIONLINE.OPTIONS.HANDSHAKE_TIMEOUT
msgctxt "STRINGS.ONIONLINE.OPTIONS.HANDSHAKE_TIMEOUT"
msgid "Join handshake timeout (seconds)"
msgstr "加入握手等待（秒）"

#. STRINGS.ONIONLINE.OPTIONS.HANDSHAKE_TIMEOUT_HINT
msgctxt "STRINGS.ONIONLINE.OPTIONS.HANDSHAKE_TIMEOUT_HINT"
msgid "Wait for authentication after connecting (15–120 seconds). Increase for slow networks. Applies to new connections."
msgstr "加入后等待身份验证的时间（15–120 秒）。较慢网络可调高；新连接生效。"

#. STRINGS.ONIONLINE.OPTIONS.PEER_TIMEOUT
msgctxt "STRINGS.ONIONLINE.OPTIONS.PEER_TIMEOUT"
msgid "Peer timeout (seconds)"
msgstr "掉线判定等待（秒）"

#. STRINGS.ONIONLINE.OPTIONS.PEER_TIMEOUT_HINT
msgctxt "STRINGS.ONIONLINE.OPTIONS.PEER_TIMEOUT_HINT"
msgid "Treat an authenticated peer as disconnected after this silence (15–180 seconds). Default 30. Applies to new connections."
msgstr "已连接玩家多久没有回应才判定掉线（15–180 秒）。默认 30 秒；新连接生效。"

#. STRINGS.ONIONLINE.OPTIONS.RECONNECT_WINDOW
msgctxt "STRINGS.ONIONLINE.OPTIONS.RECONNECT_WINDOW"
msgid "Reconnect grace period (seconds)"
msgstr "自动重连保留时间（秒）"

#. STRINGS.ONIONLINE.OPTIONS.RECONNECT_WINDOW_HINT
msgctxt "STRINGS.ONIONLINE.OPTIONS.RECONNECT_WINDOW_HINT"
msgid "Retry disconnected sessions and retain host seats for 30–1800 seconds. Never shorter than peer timeout. Applies to new connections; the host controls seat retention."
msgstr "断线后的重试时间及星系主人席位保留时间（30–1800 秒）。至少等于掉线判定等待；新连接生效，星系主人决定实际席位保留。"

#. STRINGS.ONIONLINE.OPTIONS.CHAT_HISTORY
msgctxt "STRINGS.ONIONLINE.OPTIONS.CHAT_HISTORY"
msgid "Chat history limit"
msgstr "聊天记录保留条数"

#. STRINGS.ONIONLINE.OPTIONS.CHAT_HISTORY_HINT
msgctxt "STRINGS.ONIONLINE.OPTIONS.CHAT_HISTORY_HINT"
msgid "Keep the latest 20–500 messages in memory per system. Applies to new connections. Joining players can recover only the host's retained history; chat is not saved to disk."
msgstr "每个星系在内存中保留最近 20–500 条消息。新连接生效；新加入玩家最多补收星系主人保留的记录，不写入存档。"

#. STRINGS.ONIONLINE.OPTIONS.CHAT_FONT
msgctxt "STRINGS.ONIONLINE.OPTIONS.CHAT_FONT"
msgid "Chat message font size"
msgstr "聊天正文字号"

#. STRINGS.ONIONLINE.OPTIONS.CHAT_FONT_HINT
msgctxt "STRINGS.ONIONLINE.OPTIONS.CHAT_FONT_HINT"
msgid "Message body font size (14–28). Does not change message length limits. Requires a game restart."
msgstr "聊天正文的文字大小（14–28）。不改变消息长度限制；重启后生效。"

#. STRINGS.ONIONLINE.MODERATION.TITLE
msgctxt "STRINGS.ONIONLINE.MODERATION.TITLE"
msgid "System member management"
msgstr "星系成员管理"

#. STRINGS.ONIONLINE.MODERATION.MANAGE
msgctxt "STRINGS.ONIONLINE.MODERATION.MANAGE"
msgid "Manage"
msgstr "管理"

#. STRINGS.ONIONLINE.MODERATION.REASON
msgctxt "STRINGS.ONIONLINE.MODERATION.REASON"
msgid "Reason (optional; up to 128 characters)"
msgstr "原因（可选；最多 128 字）"

#. STRINGS.ONIONLINE.MODERATION.KICK
msgctxt "STRINGS.ONIONLINE.MODERATION.KICK"
msgid "Kick from system"
msgstr "踢出星系"

#. STRINGS.ONIONLINE.MODERATION.BAN
msgctxt "STRINGS.ONIONLINE.MODERATION.BAN"
msgid "Kick and ban"
msgstr "踢出并封禁"

#. STRINGS.ONIONLINE.MODERATION.BANS
msgctxt "STRINGS.ONIONLINE.MODERATION.BANS"
msgid "Bans"
msgstr "封禁"

#. STRINGS.ONIONLINE.MODERATION.UNBAN
msgctxt "STRINGS.ONIONLINE.MODERATION.UNBAN"
msgid "Unban"
msgstr "解除封禁"

#. STRINGS.ONIONLINE.MODERATION.CLOSE
msgctxt "STRINGS.ONIONLINE.MODERATION.CLOSE"
msgid "Close"
msgstr "关闭"

#. STRINGS.ONIONLINE.MODERATION.EMPTY
msgctxt "STRINGS.ONIONLINE.MODERATION.EMPTY"
msgid "No bans in this system"
msgstr "当前星系没有封禁记录"

#. STRINGS.ONIONLINE.MODERATION.SCOPE_STEAM
msgctxt "STRINGS.ONIONLINE.MODERATION.SCOPE_STEAM"
msgid "Bans use the Steam account verified by the connection. Once a colony is loaded, bans are stored with it. Save the game to keep changes. Player saves are preserved."
msgstr "封禁根据 Steam 连接验证的账号生效。殖民地加载后，封禁随该殖民地存档保存。请正常保存游戏以保留变更。不会删除玩家存档。"

#. STRINGS.ONIONLINE.MODERATION.SCOPE_LAN
msgctxt "STRINGS.ONIONLINE.MODERATION.SCOPE_LAN"
msgid "LAN only revokes known system credentials; a fresh identity can rejoin. There is no account ban. Records last until this system closes. Saves are preserved."
msgstr "局域网仅能撤销当前星系身份。对方新建连接身份后仍可能加入；没有账号级封禁。关闭星系后清除记录。不删除玩家存档。"

#. STRINGS.ONIONLINE.ERROR.PLAYER_KICKED
msgctxt "STRINGS.ONIONLINE.ERROR.PLAYER_KICKED"
msgid "The host removed you from the system. Your local colony can continue."
msgstr "星系主人已将你踢出星系；本地星球仍可继续"

#. STRINGS.ONIONLINE.ERROR.PLAYER_BANNED
msgctxt "STRINGS.ONIONLINE.ERROR.PLAYER_BANNED"
msgid "The host has banned you from this system."
msgstr "星系主人已禁止你加入这个星系"

#. STRINGS.ONIONLINE.ERROR.MODERATION_FAILED
msgctxt "STRINGS.ONIONLINE.ERROR.MODERATION_FAILED"
msgid "Could not apply the action; the member may have left or the ban list is full."
msgstr "未能执行管理操作；成员可能已离开或封禁列表已满"

#. STRINGS.ONIONLINE.PLANET.SELECT
msgctxt "STRINGS.ONIONLINE.PLANET.SELECT"
msgid "Choose another asteroid"
msgstr "切换携带的星球"

#. STRINGS.ONIONLINE.UI.PLAYER_COUNT
msgctxt "STRINGS.ONIONLINE.UI.PLAYER_COUNT"
msgid "{0} players"
msgstr "{0} 位玩家"

#. STRINGS.ONIONLINE.ERROR.PLANET_SYSTEM_FULL
msgctxt "STRINGS.ONIONLINE.ERROR.PLANET_SYSTEM_FULL"
msgid "No arrival positions remain in this system. You can continue browsing."
msgstr "星系内没有可用落点；仍可留在这里浏览"

#. STRINGS.ONIONLINE.PLANET.SELECTED
msgctxt "STRINGS.ONIONLINE.PLANET.SELECTED"
msgid "Selected asteroid:"
msgstr "携带星球："

#. STRINGS.ONIONLINE.PLANET.NONE
msgctxt "STRINGS.ONIONLINE.PLANET.NONE"
msgid "Not ready"
msgstr "尚未就绪"

#. STRINGS.ONIONLINE.PLANET.OWNED_NAME
msgctxt "STRINGS.ONIONLINE.PLANET.OWNED_NAME"
msgid "{0}'s {1}"
msgstr "{0} 的 {1}"

#. STRINGS.ONIONLINE.PLANET.REMOTE_VIEW
msgctxt "STRINGS.ONIONLINE.PLANET.REMOTE_VIEW"
msgid "View this asteroid with its owner-approved visibility. Unshared interiors remain hidden."
msgstr "查看这颗星球的授权观察画面；未共享内部不会显示。"

#. STRINGS.ONIONLINE.PLANET.RETURN_HOME
msgctxt "STRINGS.ONIONLINE.PLANET.RETURN_HOME"
msgid "Return to my system"
msgstr "返回自己的星系"

#. STRINGS.ONIONLINE.PLANET.CLOSE_SYSTEM
msgctxt "STRINGS.ONIONLINE.PLANET.CLOSE_SYSTEM"
msgid "Close public system"
msgstr "关闭公开星系"

#. STRINGS.ONIONLINE.PLANET.HOME_READY
msgctxt "STRINGS.ONIONLINE.PLANET.HOME_READY"
msgid "Your computer simulates your asteroid. Its identity is stored in your native save."
msgstr "星球由本机计算；身份随原生存档保存。"

#. STRINGS.ONIONLINE.PLANET.ADMITTED
msgctxt "STRINGS.ONIONLINE.PLANET.ADMITTED"
msgid "Asteroid admitted. Select a member to observe their authorized map."
msgstr "星球已入驻；点成员查看授权地图。"

#. STRINGS.ONIONLINE.PLANET.WAITING
msgctxt "STRINGS.ONIONLINE.PLANET.WAITING"
msgid "Waiting for asteroid admission. Chat is available."
msgstr "等待星系主人接纳星球；此时可以聊天。"

#. STRINGS.ONIONLINE.ERROR.PLANET_INVALID_MANIFEST
msgctxt "STRINGS.ONIONLINE.ERROR.PLANET_INVALID_MANIFEST"
msgid "Invalid asteroid identity or size; admission was not registered."
msgstr "星球身份或尺寸无效；未登记入驻"

#. STRINGS.ONIONLINE.ERROR.PLANET_IDENTITY_VERSION
msgctxt "STRINGS.ONIONLINE.ERROR.PLANET_IDENTITY_VERSION"
msgid "The online identity version in this save is unsupported."
msgstr "存档中的联机身份版本不受支持"

#. STRINGS.ONIONLINE.ERROR.PLANET_NOT_READY
msgctxt "STRINGS.ONIONLINE.ERROR.PLANET_NOT_READY"
msgid "Load your colony and select an asteroid first."
msgstr "请先载入自己的殖民地并选择一个星球"

#. STRINGS.ONIONLINE.ERROR.PLANET_DUPLICATE_BRANCH
msgctxt "STRINGS.ONIONLINE.ERROR.PLANET_DUPLICATE_BRANCH"
msgid "This asteroid or its online branch is already in the system."
msgstr "这颗星球或同一联机分支已在星系中"

#. STRINGS.ONIONLINE.ERROR.PLANET_SELECTION_LOCKED
msgctxt "STRINGS.ONIONLINE.ERROR.PLANET_SELECTION_LOCKED"
msgid "Return home before selecting another asteroid."
msgstr "先返回自己的星系，再更换携带的星球"

#. STRINGS.ONIONLINE.ERROR.PLANET_OWNER_ALREADY_ADMITTED
msgctxt "STRINGS.ONIONLINE.ERROR.PLANET_OWNER_ALREADY_ADMITTED"
msgid "You already have a planet in this system. Leave the original connection first."
msgstr "你已在此星系登记了一颗星球，请先离开原连接。"

#. STRINGS.ONIONLINE.ERROR.PLANET_COLONY_CHANGED
msgctxt "STRINGS.ONIONLINE.ERROR.PLANET_COLONY_CHANGED"
msgid "A different colony was loaded; the previous system connection was closed."
msgstr "已载入另一个殖民地；原星系连接已关闭"

#. STRINGS.ONIONLINE.MAP.PLAYERS
msgctxt "STRINGS.ONIONLINE.MAP.PLAYERS"
msgid "Players and asteroids"
msgstr "玩家与星球"

#. STRINGS.ONIONLINE.MAP.CHOOSE_POSITION
msgctxt "STRINGS.ONIONLINE.MAP.CHOOSE_POSITION"
msgid "Select an empty hex for the rift exit"
msgstr "点击星图空位置选择裂隙出口"

#. STRINGS.ONIONLINE.MAP.POSITION
msgctxt "STRINGS.ONIONLINE.MAP.POSITION"
msgid "Rift exit: {0} / {1}"
msgstr "裂隙出口：{0} / {1}"

#. STRINGS.ONIONLINE.MAP.CREATE_PLANET
msgctxt "STRINGS.ONIONLINE.MAP.CREATE_PLANET"
msgid "Create a new asteroid"
msgstr "创建一颗新星球"

#. STRINGS.ONIONLINE.MAP.LOAD_PLANET
msgctxt "STRINGS.ONIONLINE.MAP.LOAD_PLANET"
msgid "Choose an existing save"
msgstr "选择已有存档"

#. STRINGS.ONIONLINE.MAP.RIFT_ARRIVE
msgctxt "STRINGS.ONIONLINE.MAP.RIFT_ARRIVE"
msgid "Bring my asteroid through the rift"
msgstr "携带星球穿过裂隙"

#. STRINGS.ONIONLINE.MAP.OBSERVE
msgctxt "STRINGS.ONIONLINE.MAP.OBSERVE"
msgid "Observe selected asteroid"
msgstr "观察选中的星球"

#. STRINGS.ONIONLINE.MAP.INITIALIZING
msgctxt "STRINGS.ONIONLINE.MAP.INITIALIZING"
msgid "Waiting for asteroid initialization"
msgstr "等待星球初始化"

#. STRINGS.ONIONLINE.MAP.PREVIEW
msgctxt "STRINGS.ONIONLINE.MAP.PREVIEW"
msgid "Previewing this system. Select a landing to bring your own asteroid."
msgstr "正在浏览大厅。选择落点后可携带自己的星球加入。"

#. STRINGS.ONIONLINE.ERROR.PLANET_CHOOSE_POSITION
msgctxt "STRINGS.ONIONLINE.ERROR.PLANET_CHOOSE_POSITION"
msgid "Select an empty position and wait for host confirmation first."
msgstr "请先选择一个空位置并等待星系主人确认"

#. STRINGS.ONIONLINE.ERROR.PLANET_INVALID_POSITION
msgctxt "STRINGS.ONIONLINE.ERROR.PLANET_INVALID_POSITION"
msgid "The landing is outside this system."
msgstr "落点超出这个星系的边界"

#. STRINGS.ONIONLINE.ERROR.PLANET_POSITION_TAKEN
msgctxt "STRINGS.ONIONLINE.ERROR.PLANET_POSITION_TAKEN"
msgid "Another player claimed this position. Select another hex."
msgstr "这个位置已被另一位玩家占用，请重新选择"

#. STRINGS.ONIONLINE.ERROR.LEFT_ROOM
msgctxt "STRINGS.ONIONLINE.ERROR.LEFT_ROOM"
msgid "Returned to your home system"
msgstr "已返回自己的星系"

#. STRINGS.ONIONLINE.ERROR.LEAVE_UNCONFIRMED
msgctxt "STRINGS.ONIONLINE.ERROR.LEAVE_UNCONFIRMED"
msgid "Departure was not confirmed. No other system was joined; try again later."
msgstr "尚未确认离开结果；未加入其他星系，请稍后重试"

