<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>CycleTrim</AssemblyName>
    <RootNamespace>CycleTrim</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <ModTitle>CycleTrim</ModTitle>
    <ModDescription>Early experimental performance mod. Rebuilds the underlying algorithms and moves as much computation as possible onto the GPU. Speed first, compatibility later. / 早期实验性性能模组。重构底层算法，把尽可能多的运算搬到 GPU。先加速，再兼容。</ModDescription>
    <ModStaticID>LIghtJUNction.CycleTrim</ModStaticID>
    <ModVersion>0.4.2</ModVersion>
    <Version>$(ModVersion)</Version>
    <ModApiVersion>2</ModApiVersion>
    <IncludeOniSim Condition="'$(IncludeOniSim)' == ''">true</IncludeOniSim>
    <OniSimPython Condition="'$(OniSimPython)' == ''">python3</OniSimPython>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="OniSim/**/*.cs" />
    <Compile Include="OniSim/managed/OniSim.Mod/OniSimLoader.cs" Link="OniSim/OniSimLoader.cs" />
    <Compile Include="OniSim/managed/OniSim.Mod/NativeModule.cs" Link="OniSim/NativeModule.cs" />
    <Compile Include="OniSim/managed/OniSim.Mod/NativePlatform.cs" Link="OniSim/NativePlatform.cs" />
    <Compile Include="OniSim/managed/OniSim.Mod/MonoImageMapper.cs" Link="OniSim/MonoImageMapper.cs" />
    <Compile Include="OniSim/managed/OniSim.Mod/OfficialProfile.cs" Link="OniSim/OfficialProfile.cs" />
    <Compile Include="OniSim/managed/OniSim.Mod/PortableProfile.cs" Link="OniSim/PortableProfile.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(OniManagedPath)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(OniManagedPath)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(OniManagedPath)/Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(OniManagedPath)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(OniManagedPath)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PreviewImage Include="$(MSBuildProjectDirectory)/preview.png" Condition="Exists('$(MSBuildProjectDirectory)/preview.png')" />
    <PreviewImage Include="$(MSBuildProjectDirectory)/preview.jpg" Condition="Exists('$(MSBuildProjectDirectory)/preview.jpg')" />
    <Content Include="$(MSBuildProjectDirectory)/THIRD_PARTY_NOTICES.txt" Condition="Exists('$(MSBuildProjectDirectory)/THIRD_PARTY_NOTICES.txt')">
      <Link>THIRD_PARTY_NOTICES.txt</Link>
      <TargetPath>THIRD_PARTY_NOTICES.txt</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="GenerateModFiles" AfterTargets="Build">
    <WriteLinesToFile File="$(OutputPath)mod.yaml" Lines="title: &quot;$(ModTitle)&quot;;description: &quot;$(ModDescription)&quot;;staticID: &quot;$(ModStaticID)&quot;" Overwrite="true" />
    <WriteLinesToFile File="$(OutputPath)mod_info.yaml" Lines="supportedContent: ALL" Overwrite="true" />
    <WriteLinesToFile File="$(OutputPath)mod_info.yaml" Lines="minimumSupportedBuild: 525812" Overwrite="false" />
    <WriteLinesToFile File="$(OutputPath)mod_info.yaml" Lines="APIVersion: $(ModApiVersion)" Overwrite="false" />
    <WriteLinesToFile File="$(OutputPath)mod_info.yaml" Lines="version: &quot;$(ModVersion)&quot;" Overwrite="false" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/docs/steam-description-zh.md" DestinationFolder="$(OutputPath)docs" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)/docs/steam-description-zh.md')" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/docs/steam-description-en.md" DestinationFolder="$(OutputPath)docs" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildProjectDirectory)/docs/steam-description-en.md')" />
    <Copy SourceFiles="@(PreviewImage)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="'@(PreviewImage)' != ''" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/README.md" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PackageMod" AfterTargets="GenerateModFiles">
    <PropertyGroup>
      <DistPath Condition="'$(DistPath)' == ''">$(MSBuildProjectDirectory)/../../dist/</DistPath>
      <DistModPath>$(DistPath)$(AssemblyName)/</DistModPath>
      <ZipFile>$(DistPath)$(AssemblyName).zip</ZipFile>
    </PropertyGroup>

    <MakeDir Directories="$(DistPath)" />
    <RemoveDir Directories="$(DistModPath)" />
    <Delete Files="$(ZipFile)" />
    <Delete Files="$(DistPath)$(AssemblyName)-src.tar.gz" />
    <Delete Files="$(DistPath)delivery-validation.json" />
    <Delete Files="$(DistPath)source-build-validation.json" />

    <ItemGroup>
      <ModOutputFiles Include="$(OutputPath)mod.yaml" />
      <ModOutputFiles Include="$(OutputPath)mod_info.yaml" />
      <ModOutputFiles Include="$(OutputPath)THIRD_PARTY_NOTICES.txt" Condition="Exists('$(OutputPath)THIRD_PARTY_NOTICES.txt')" />
      <ModOutputFiles Include="$(OutputPath)preview.png" Condition="Exists('$(OutputPath)preview.png')" />
      <ModOutputFiles Include="$(OutputPath)preview.jpg" Condition="Exists('$(OutputPath)preview.jpg')" />
      <ModOutputFiles Include="$(OutputPath)README.md" />
      <ModOutputFiles Include="$(MSBuildProjectDirectory)/../../LICENSE;$(MSBuildProjectDirectory)/../../LICENSE.MIT;$(MSBuildProjectDirectory)/../../LICENSING.md;$(MSBuildProjectDirectory)/../../UPSTREAM.toml" />
      <ModOutputFiles Include="$(OutputPath)docs/steam-description-zh.md" Condition="Exists('$(OutputPath)docs/steam-description-zh.md')" />
      <ModOutputFiles Include="$(OutputPath)docs/steam-description-en.md" Condition="Exists('$(OutputPath)docs/steam-description-en.md')" />
    </ItemGroup>
    <Copy SourceFiles="@(ModOutputFiles)" DestinationFolder="$(DistModPath)" />
    <Copy SourceFiles="$(JlibBootstrapAssembly)" DestinationFiles="$(DistModPath)$(AssemblyName).dll" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DistModPath)implementation" />
    <ItemGroup Condition="'$(IncludeOniSim)' == 'true'">
      <OniSimNativeFiles Include="$(OutputPath)OniSim/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(OniSimNativeFiles)" DestinationFiles="@(OniSimNativeFiles->'$(DistModPath)OniSim/%(RecursiveDir)%(Filename)%(Extension)')" />
    <ItemGroup>
      <OniSimValidation Include="$(MSBuildProjectDirectory)/OniSim/PARALLEL-VALIDATION.md;$(MSBuildProjectDirectory)/OniSim/RUNTIME-VALIDATION.md;$(MSBuildProjectDirectory)/OniSim/PROGRESS.md;$(MSBuildProjectDirectory)/OniSim/PERFORMANCE.md" />
    </ItemGroup>
    <Copy SourceFiles="@(OniSimValidation)" DestinationFolder="$(DistModPath)OniSim" Condition="'$(IncludeOniSim)' == 'true'" />
    <MakeDir Directories="$(DistModPath)OniSim/conformance/results" Condition="'$(IncludeOniSim)' == 'true'" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/OniSim/conformance/README.md" DestinationFolder="$(DistModPath)OniSim/conformance" Condition="'$(IncludeOniSim)' == 'true'" />
    <ItemGroup>
      <OniSimConformanceReceipts Include="$(MSBuildProjectDirectory)/OniSim/conformance/results/*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(OniSimConformanceReceipts)" DestinationFolder="$(DistModPath)OniSim/conformance/results" Condition="'$(IncludeOniSim)' == 'true'" />
    <ZipDirectory SourceDirectory="$(DistModPath)" DestinationFile="$(ZipFile)" Overwrite="true" />
    <Exec Command="tar -czf &quot;$(DistPath)$(AssemblyName)-src.tar.gz&quot; -C &quot;$(MSBuildProjectDirectory)/../..&quot; --exclude=bin --exclude=obj --exclude=target --exclude=dist --exclude=history --exclude=artifacts --exclude=__pycache__ mods/CycleTrim build/Jlib.Consumer.targets sdk/Jlib.Bootstrap mods/Jlib/Jlib mods/Jlib/PLibCore mods/Jlib/PLibActions mods/Jlib/PLibAVC mods/Jlib/PLibBuildings mods/Jlib/PLibDatabase mods/Jlib/PLibLighting mods/Jlib/PLibOptions mods/Jlib/PLibUI mods/Jlib/LICENSE mods/Jlib/UPSTREAM.toml Directory.Build.props.example LICENSE LICENSE.MIT LICENSING.md UPSTREAM.toml scripts/build_onisim_native.py" />

    <Message Text="Packaged mod -&gt; $(ZipFile)" Importance="high" />
    <Message Text="Packaged source -&gt; $(DistPath)$(AssemblyName)-src.tar.gz" Importance="high" />
  </Target>

  <Target Name="BuildOniSimNative" BeforeTargets="PackageMod" Condition="'$(IncludeOniSim)' == 'true'">
    <PropertyGroup>
      <OniSimBundlePath>$(OniSimNativeBundle)</OniSimBundlePath>
      <OniSimBundlePath Condition="'$(OniSimBundlePath)' == ''">$(MSBuildProjectDirectory)/obj/$(Configuration)/OniSimBundle</OniSimBundlePath>
    </PropertyGroup>
    <Exec Condition="'$(OniSimNativeBundle)' == ''" IgnoreStandardErrorWarningFormat="true" Command="$(OniSimPython) &quot;$(MSBuildProjectDirectory)/../../scripts/build_onisim_native.py&quot; --output-root &quot;$(OniSimBundlePath)&quot;" />
    <Exec Condition="'$(OniSimNativeBundle)' != ''" IgnoreStandardErrorWarningFormat="true" Command="$(OniSimPython) &quot;$(MSBuildProjectDirectory)/../../scripts/build_onisim_native.py&quot; --validate-bundle &quot;$(OniSimBundlePath)&quot;" />
    <RemoveDir Directories="$(OutputPath)OniSim" />
    <ItemGroup>
      <OniSimBundleFiles Include="$(OniSimBundlePath)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(OniSimBundleFiles)" DestinationFiles="@(OniSimBundleFiles->'$(OutputPath)OniSim/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <Import Project="../../build/Jlib.Consumer.targets" />
</Project>
