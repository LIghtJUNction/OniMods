<Project>
  <Target Name="MergePLibIntoCycleTrim" AfterTargets="Build" BeforeTargets="GenerateModFiles" Condition="Exists('$(OutputPath)PLib.dll')">
    <ItemGroup>
      <CycleTrimMergeAssemblies Include="$(OutputPath)$(TargetName)$(TargetExt)" />
      <CycleTrimMergeAssemblies Include="$(OutputPath)PLib.dll" />
    </ItemGroup>
    <ILRepack
      Parallel="true"
      DebugInfo="true"
      AllowDuplicateResources="true"
      LibraryPath="$(OniManagedPath)"
      InputAssemblies="@(CycleTrimMergeAssemblies)"
      TargetKind="SameAsPrimaryAssembly"
      OutputFile="$(OutputPath)$(TargetName)$(TargetExt)" />
    <Delete Files="$(OutputPath)PLib.dll;$(OutputPath)PLib.xml" />
  </Target>
</Project>
