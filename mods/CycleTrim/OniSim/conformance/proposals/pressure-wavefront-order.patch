+#[cfg(test)]
+mod pressure_schedule_tests {
+    use super::*;
+    use std::collections::HashMap;
+
+    #[test]
+    fn wavefront_visits_each_cell_once_and_preserves_all_overlapping_pairs() {
+        for width in [0, 1, 2, 3, 7, 16] {
+            for height in [0, 1, 2, 3, 8, 17] {
+                for direction in [-1, 1] {
+                    for (min_x, min_y) in [(1, 1), (3, 5)] {
+                        let region = Region {
+                            min_x,
+                            min_y,
+                            max_x: min_x + width,
+                            max_y: min_y + height,
+                            ..Region::default()
+                        };
+                        let mut original = Vec::new();
+                        let mut reordered = Vec::new();
+                        pressure_cells(region, direction, 64, false, |c| original.push(c));
+                        pressure_cells(region, direction, 64, true, |c| reordered.push(c));
+                        let mut expected = original.clone();
+                        expected.sort_unstable();
+                        let mut actual = reordered.clone();
+                        actual.sort_unstable();
+                        assert_eq!(actual, expected);
+                        assert_eq!(actual.len(), (width * height) as usize);
+                        actual.dedup();
+                        assert_eq!(actual.len(), expected.len());
+                        let positions: HashMap<_, _> = reordered
+                            .iter()
+                            .enumerate()
+                            .map(|(index, &cell)| (cell, index))
+                            .collect();
+                        let footprint = |c: usize| {
+                            let side = c.wrapping_add_signed(direction as isize);
+                            [c, side, c + 64, side + 64]
+                        };
+                        for (index, &left) in original.iter().enumerate() {
+                            for &right in &original[index + 1..] {
+                                if footprint(left).iter().any(|c| footprint(right).contains(c)) {
+                                    assert!(positions[&left] < positions[&right]);
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
