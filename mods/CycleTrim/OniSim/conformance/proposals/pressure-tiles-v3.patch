+use super::*;
+use crate::tables::{Disease, RangeInfo};
+
+fn elements() -> ElementTable {
+    let mut bytes = 4_i32.to_le_bytes().to_vec();
+    for (index, hash) in [0xa9360b34_u32, 0x2d39bf75, 0x6d95058c, 0x12345678]
+        .into_iter()
+        .enumerate()
+    {
+        let mut record = [0_u8; 164];
+        record[..4].copy_from_slice(&hash.to_le_bytes());
+        record[8..10].copy_from_slice(&(index as u16).to_le_bytes());
+        record[10] = [0, 0, 3, 1][index];
+        record[36..40].copy_from_slice(&0.25_f32.to_le_bytes());
+        bytes.extend_from_slice(&record);
+    }
+    bytes.extend_from_slice(&[0; 16]);
+    ElementTable::parse(&bytes).unwrap()
+}
+
+fn diseases() -> DiseaseTable {
+    let range = RangeInfo {
+        min_viable: 0.0,
+        min_growth: 0.0,
+        max_growth: 0.0,
+        max_viable: 0.0,
+    };
+    DiseaseTable {
+        element_count: 4,
+        diseases: (0..2)
+            .map(|id| Disease {
+                name: String::new(),
+                raw_header: [0; 76],
+                hash: id,
+                strength: (id + 1) as f32,
+                temperature_range: range.clone(),
+                temperature_half_lives: range.clone(),
+                pressure_range: range.clone(),
+                pressure_half_lives: range.clone(),
+                radiation_kill_rate: 0.0,
+                elements: Vec::new(),
+            })
+            .collect(),
+    }
+}
+
+fn fixture(elements: &ElementTable, direction: i32, seed: usize) -> PhysicsWorld {
+    let mut world =
+        PhysicsWorld::new(137, 79, 42, elements).unwrap_or_else(|e| panic!("{}", e.message));
+    for cell in 0..world.write.mass.len() {
+        let n = cell.wrapping_mul(17).wrapping_add(seed);
+        let x = cell % world.stride;
+        let y = cell / world.stride;
+        world.write.element[cell] =
+            if x == 0 || x == world.stride - 1 || y == 0 || y == world.padded_height - 1 {
+                2
+            } else if n % 11 == 0 {
+                1
+            } else {
+                3
+            };
+        world.write.mass[cell] = [0.0, 0.001, 1.0, 4.0, 1000.0, f32::from_bits(1), -0.0][n % 7];
+        world.write.temperature[cell] =
+            [0.0, 1.0, 273.15, 300.0, 1000.0, f32::from_bits(0x7fc12345)][n % 6];
+        world.write.properties[cell] = u8::from(n % 43 == 0);
+        world.write.disease_idx[cell] = [0, 1, 255][n % 3];
+        world.write.disease_count[cell] = [0, 1, 7, 10000, i32::MAX][n % 5];
+        world.write.disease_growth[cell] = f32::from_bits((n as u32).wrapping_mul(123457));
+        world.write.disease_infestation[cell] = n as u8;
+        world.flow[cell] = [n as f32 * 0.01; 4];
+        world.dirty[cell] = n % 7 == 0;
+        world.dirty_flags[cell] = (n % 32) as u8;
+    }
+    world.read.copy_from(&world.write);
+    world.scan_direction = direction;
+    world
+}
+
+fn equal(actual: &PhysicsWorld, expected: &PhysicsWorld) {
+    let a = &actual.write;
+    let e = &expected.write;
+    assert_eq!(a.element, e.element);
+    assert_eq!(a.disease_idx, e.disease_idx);
+    assert_eq!(a.disease_count, e.disease_count);
+    assert_eq!(a.disease_infestation, e.disease_infestation);
+    assert_eq!(a.properties, e.properties);
+    for (a, e) in [
+        (&a.mass, &e.mass),
+        (&a.temperature, &e.temperature),
+        (&a.disease_growth, &e.disease_growth),
+    ] {
+        assert!(a.iter().zip(e).all(|(a, e)| a.to_bits() == e.to_bits()));
+    }
+    assert!(
+        actual
+            .flow
+            .iter()
+            .flatten()
+            .zip(expected.flow.iter().flatten())
+            .all(|(a, e)| a.to_bits() == e.to_bits())
+    );
+    assert_eq!(actual.dirty, expected.dirty);
+    assert_eq!(actual.dirty_flags, expected.dirty_flags);
+}
+
+fn ids(events: &EventQueues) -> Vec<i32> {
+    let mut ids: Vec<_> = events
+        .substance_change_info
+        .iter()
+        .map(|e| e.cell_idx)
+        .collect();
+    ids.sort_unstable();
+    ids.dedup();
+    ids
+}
+
+fn retained_bytes(s: &Scratch) -> usize {
+    fn bytes<T>(v: &Vec<T>) -> usize {
+        v.capacity() * std::mem::size_of::<T>()
+    }
+    fn cells(c: &Cells) -> usize {
+        bytes(&c.element)
+            + bytes(&c.temperature)
+            + bytes(&c.mass)
+            + bytes(&c.properties)
+            + bytes(&c.insulation)
+            + bytes(&c.strength)
+            + bytes(&c.disease_idx)
+            + bytes(&c.disease_count)
+            + bytes(&c.disease_infestation)
+            + bytes(&c.disease_growth)
+            + bytes(&c.radiation)
+    }
+    let w = &s.world;
+    std::mem::size_of::<Scratch>()
+        + cells(&w.read)
+        + cells(&w.write)
+        + bytes(&w.backwall_element)
+        + bytes(&w.backwall_mass)
+        + bytes(&w.backwall_temperature)
+        + bytes(&w.flow)
+        + bytes(&w.accumulated_flow)
+        + bytes(&w.radiation_transmission)
+        + w.inactive_mask.as_ref().map_or(0, bytes)
+        + bytes(&w.dirty)
+        + bytes(&w.dirty_flags)
+        + bytes(&w.regions)
+        + bytes(&w.world_offsets)
+        + bytes(&w.active_mask)
+        + bytes(&s.tasks)
+        + bytes(&s.touched)
+        + bytes(&s.marks)
+        + s.events
+            .storage_ranges()
+            .iter()
+            .map(|(_, size)| size)
+            .sum::<usize>()
+}
