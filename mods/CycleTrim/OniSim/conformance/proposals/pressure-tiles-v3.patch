+// First validate scheduling independently of parallel execution. All conflicting
+// tasks retain native order; same-wave cells have disjoint 2x2 footprints.
+// With unmasked exceptions, retain literal order to preserve trap sequencing.
+fn pressure_cells(
+    region: Region,
+    direction: i32,
+    stride: usize,
+    wavefront: bool,
+    mut visit: impl FnMut(usize),
+) {
+    let width = (region.max_x - region.min_x) as usize;
+    let height = (region.max_y - region.min_y) as usize;
+    if width == 0 || height == 0 {
+        return;
+    }
+    if !wavefront {
+        for y in region.min_y..region.max_y {
+            let row = y as usize * stride;
+            let (mut cell, stop) = if direction > 0 {
+                (row + region.min_x as usize, row + region.max_x as usize)
+            } else {
+                (row + region.max_x as usize, row + region.min_x as usize)
+            };
+            while cell != stop {
+                visit(cell);
+                cell = cell.wrapping_add_signed(direction as isize);
+            }
+        }
+        return;
+    }
+    for wave in 0..width + 2 * (height - 1) {
+        let first_y = wave.saturating_sub(width - 1).div_ceil(2);
+        let last_y = (wave / 2).min(height - 1);
+        for y in first_y..=last_y {
+            let x = wave - 2 * y;
+            let physical_x = if direction > 0 {
+                region.min_x as usize + x
+            } else {
+                region.max_x as usize - x
+            };
+            visit((region.min_y as usize + y) * stride + physical_x);
+        }
+    }
+}
