+//! Bounded grid dependencies and owned job handoff. The coordinator alone
+//! gathers and commits global cells; workers never borrow the global world.
+use std::any::Any;
+use std::collections::VecDeque;
+use std::panic::{AssertUnwindSafe, catch_unwind, resume_unwind};
+use std::sync::{Mutex, mpsc};
+
+use super::{EventQueues, PhysicsWorld, Region, Scratch};
+use crate::tables::ElementTable;
+
+const MAX_NODES: usize = 65_536;
+
+pub(super) struct Graph {
+    bands: usize,
+    rows: usize,
+    pending: Vec<u8>,
+    ready: VecDeque<usize>,
+}
+
+impl Graph {
+    pub(super) const fn new() -> Self {
+        Self {
+            bands: 0,
+            rows: 0,
+            pending: Vec::new(),
+            ready: VecDeque::new(),
+        }
+    }
+
+    pub(super) fn prepare(&mut self, bands: usize, rows: usize) -> bool {
+        let Some(count) = bands.checked_mul(rows).filter(|&n| n > 0 && n <= MAX_NODES) else {
+            return false;
+        };
+        self.pending.clear();
+        self.ready.clear();
+        if self.pending.try_reserve_exact(count).is_err()
+            || self.ready.try_reserve_exact(count).is_err()
+        {
+            return false;
+        }
+        self.bands = bands;
+        self.rows = rows;
+        self.pending.resize(count, 0);
+        for (node, pending) in self.pending.iter_mut().enumerate() {
+            *pending = u8::from(node % bands > 0) + u8::from(node / bands > 0);
+        }
+        self.ready.push_back(0);
+        true
+    }
+
+    fn complete(&mut self, node: usize) {
+        assert_eq!(
+            self.pending[node], 0,
+            "Tile completed before its dependencies, or twice"
+        );
+        self.pending[node] = u8::MAX;
+        for child in [
+            (node % self.bands + 1 < self.bands).then_some(node + 1),
+            (node / self.bands + 1 < self.rows).then_some(node + self.bands),
+        ]
+        .into_iter()
+        .flatten()
+        {
+            assert!(self.pending[child] > 0 && self.pending[child] != u8::MAX);
+            self.pending[child] -= 1;
+            if self.pending[child] == 0 {
+                self.ready.push_back(child);
+            }
+        }
+    }
+}
+
+struct Job {
+    node: usize,
+    scratch: Scratch,
+}
+type Failure = Box<dyn Any + Send>;
+
+pub(super) fn run<F: Fn(&mut Scratch) + Sync>(
+    world: &mut PhysicsWorld,
+    elements: &ElementTable,
+    events: &mut EventQueues,
+    region: Region,
+    pool: &rayon::ThreadPool,
+    free: &mut Vec<Scratch>,
+    graph: &mut Graph,
+    compute: &F,
+) {
+    let workers = pool.current_num_threads();
+    let (jobs, receive_jobs) = mpsc::sync_channel::<Job>(workers);
+    let receive_jobs = Mutex::new(receive_jobs);
+    let queue = &receive_jobs;
+    let (completed, receive_completed) = mpsc::sync_channel::<(Job, Option<Failure>)>(workers);
+    // Owning the job sender inside this closure is deliberate: unwinding the
+    // coordinator closes it before the scope joins blocked receiver workers.
+    pool.in_place_scope(move |scope| {
+        for _ in 0..workers {
+            let output = completed.clone();
+            scope.spawn(move |_| {
+                loop {
+                    let next = queue
+                        .lock()
+                        .unwrap_or_else(|poison| poison.into_inner())
+                        .recv();
+                    let Ok(mut job) = next else {
+                        break;
+                    };
+                    let failure =
+                        catch_unwind(AssertUnwindSafe(|| compute(&mut job.scratch))).err();
+                    if output.send((job, failure)).is_err() {
+                        break;
+                    }
+                }
+            });
+        }
+        drop(completed);
+        let mut in_flight = 0;
+        let mut finished = 0;
+        let mut failure = None;
+        while finished < graph.pending.len() && failure.is_none() {
+            while in_flight < workers {
+                let Some(node) = graph.ready.pop_front() else {
+                    break;
+                };
+                let mut scratch = free.pop().expect("Preflight reserved every worker patch");
+                if scratch.prepare(
+                    world,
+                    elements,
+                    region,
+                    node % graph.bands,
+                    node / graph.bands,
+                ) {
+                    jobs.send(Job { node, scratch })
+                        .expect("Scoped pressure workers stopped unexpectedly");
+                    in_flight += 1;
+                } else {
+                    free.push(scratch);
+                    graph.complete(node);
+                    finished += 1;
+                }
+            }
+            if in_flight == 0 {
+                assert_eq!(
+                    finished,
+                    graph.pending.len(),
+                    "Pressure dependency graph stalled"
+                );
+                break;
+            }
+            let (job, error) = receive_completed
+                .recv()
+                .expect("Pressure worker result channel disconnected");
+            in_flight -= 1;
+            if error.is_none() {
+                job.scratch.commit(world, events);
+                graph.complete(job.node);
+                finished += 1;
+            } else {
+                failure = error;
+            }
+            free.push(job.scratch);
+        }
+        // A failed kernel is not retried or converted to a partial success.
+        // Drain ownership before resuming its panic on the simulation thread.
+        while in_flight != 0 {
+            let (job, error) = receive_completed
+                .recv()
+                .expect("Pressure result ownership was lost");
+            in_flight -= 1;
+            free.push(job.scratch);
+            if failure.is_none() {
+                failure = error;
+            }
+        }
+        drop(jobs);
+        if let Some(error) = failure {
+            resume_unwind(error);
+        }
+    });
+}
