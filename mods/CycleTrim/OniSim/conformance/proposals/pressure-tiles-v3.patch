+mod tests {
+    use super::*;
+
+    #[test]
+    fn ready_nodes_have_completed_predecessors_and_each_completes_once() {
+        let mut graph = Graph::new();
+        for bands in [1, 2, 3, 7, 32] {
+            for rows in [1, 2, 3, 17] {
+                assert!(graph.prepare(bands, rows));
+                let mut done = vec![false; bands * rows];
+                let mut count = 0;
+                while let Some(node) = if count % 2 == 0 {
+                    graph.ready.pop_front()
+                } else {
+                    graph.ready.pop_back()
+                } {
+                    assert!(!done[node]);
+                    if node % bands > 0 {
+                        assert!(done[node - 1]);
+                    }
+                    if node / bands > 0 {
+                        assert!(done[node - bands]);
+                    }
+                    done[node] = true;
+                    graph.complete(node);
+                    count += 1;
+                }
+                assert_eq!(count, bands * rows);
+            }
+        }
+    }
+
+    #[test]
+    fn graph_preflight_caps_metadata_and_rejects_overflow() {
+        let mut graph = Graph::new();
+        assert!(graph.prepare(256, 256));
+        assert!(graph.pending.capacity() + 8 * graph.ready.capacity() <= 600 * 1024);
+        assert!(!graph.prepare(257, 256));
+        assert!(!graph.prepare(usize::MAX, usize::MAX));
+        assert!(!graph.prepare(0, 1));
+    }
