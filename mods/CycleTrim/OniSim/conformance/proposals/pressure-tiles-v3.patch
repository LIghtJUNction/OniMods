+//! Experimental owned skew tiles. No worker borrows the global mutable world.
+use std::cell::RefCell;
+
+#[path = "pressure_dag.rs"]
+mod dag;
+
+use crate::events::EventQueues;
+use crate::float_env::FloatEnv;
+use crate::tables::{DiseaseTable, ElementTable};
+use crate::world::{Cells, PhysicsWorld, Region};
+
+const BAND: usize = 32;
+const ROWS: usize = 16;
+const PATCH_WIDTH: usize = BAND + 2 * (ROWS - 1) + 1;
+const PATCH_HEIGHT: usize = ROWS + 1;
+const PATCH_CELLS: usize = (PATCH_WIDTH + 2) * (PATCH_HEIGHT + 2);
+const MAX_TASKS: usize = BAND * ROWS;
+
+struct Scratch {
+    world: PhysicsWorld,
+    events: EventQueues,
+    tasks: Vec<usize>,
+    touched: Vec<(usize, usize)>,
+    marks: Vec<u8>,
+}
+
+thread_local! {
+    // Owned by the simulation thread and dropped with that thread. At most
+    // eight fixed-size patches survive; no world's dimensions enter capacity.
+    static SCRATCH: RefCell<Vec<Scratch>> = const { RefCell::new(Vec::new()) };
+    static GRAPH: RefCell<dag::Graph> = const { RefCell::new(dag::Graph::new()) };
+}
+
+fn copy_cell(source: &Cells, from: usize, target: &mut Cells, to: usize) {
+    target.element[to] = source.element[from];
+    target.temperature[to] = source.temperature[from];
+    target.mass[to] = source.mass[from];
+    target.properties[to] = source.properties[from];
+    target.insulation[to] = source.insulation[from];
+    target.strength[to] = source.strength[from];
+    target.disease_idx[to] = source.disease_idx[from];
+    target.disease_count[to] = source.disease_count[from];
+    target.disease_infestation[to] = source.disease_infestation[from];
+    target.disease_growth[to] = source.disease_growth[from];
+    target.radiation[to] = source.radiation[from];
+}
+
+impl Scratch {
+    fn new(elements: &ElementTable) -> Option<Self> {
+        let world = PhysicsWorld::new(PATCH_WIDTH, PATCH_HEIGHT, 0, elements).ok()?;
+        let mut tasks = Vec::new();
+        tasks.try_reserve_exact(MAX_TASKS).ok()?;
+        let mut touched = Vec::new();
+        touched.try_reserve_exact(PATCH_CELLS).ok()?;
+        let mut marks = Vec::new();
+        marks.try_reserve_exact(PATCH_CELLS).ok()?;
+        marks.resize(PATCH_CELLS, 0);
+        let mut events = EventQueues::default();
+        events
+            .substance_change_info
+            .try_reserve_exact(3 * MAX_TASKS)
+            .ok()?;
+        Some(Self {
+            world,
+            events,
+            tasks,
+            touched,
+            marks,
+        })
+    }
+
+    fn prepare(
+        &mut self,
+        source: &PhysicsWorld,
+        elements: &ElementTable,
+        region: Region,
+        band: usize,
+        row_band: usize,
+    ) -> bool {
+        self.tasks.clear();
+        self.touched.clear();
+        self.marks.fill(0);
+        self.events.clear();
+        let width = (region.max_x - region.min_x) as usize;
+        let height = (region.max_y - region.min_y) as usize;
+        let first_y = row_band * ROWS;
+        let end_y = (first_y + ROWS).min(height);
+        let range = |y| {
+            let first = (band * BAND).saturating_sub(2 * y);
+            let end = ((band + 1) * BAND).saturating_sub(2 * y).min(width);
+            first..end
+        };
+        let mut min_x = usize::MAX;
+        let mut max_x = 0;
+        for y in first_y..end_y {
+            let row = range(y);
+            if !row.is_empty() {
+                min_x = min_x.min(row.start);
+                max_x = max_x.max(row.end); // Includes the side-neighbour halo.
+            }
+        }
+        if min_x == usize::MAX {
+            return false;
+        }
+        debug_assert!(max_x - min_x < PATCH_WIDTH);
+        let direction = source.scan_direction;
+        self.world.scan_direction = direction;
+        self.world.sink_element = source.sink_element;
+        self.world.vacuum_element = source.vacuum_element;
+        self.world.boundary_element = source.boundary_element;
+        let local = |x, y| {
+            let physical_x = if direction > 0 {
+                x - min_x + 1
+            } else {
+                max_x - x + 1
+            };
+            (y - first_y + 1) * (PATCH_WIDTH + 2) + physical_x
+        };
+        for y in first_y..end_y {
+            for x in range(y) {
+                let physical_x = if direction > 0 {
+                    region.min_x as usize + x
+                } else {
+                    region.max_x as usize - x
+                };
+                let source_cell = (region.min_y as usize + y) * source.stride + physical_x;
+                let element = source.read.element[source_cell] as usize;
+                // These immutable exclusions cannot become eligible during
+                // this pressure phase. Do not classify using mutable fields.
+                if source.read.properties[source_cell] & 1 != 0
+                    || elements.elements[element].record.state & 2 != 0
+                {
+                    continue;
+                }
+                self.tasks.push(local(x, y));
+                for (u, v) in [(x, y), (x + 1, y), (x, y + 1), (x + 1, y + 1)] {
+                    let to = local(u, v);
+                    if self.marks[to] != 0 {
+                        continue;
+                    }
+                    self.marks[to] = 1;
+                    let physical_x = if direction > 0 {
+                        region.min_x as usize + u
+                    } else {
+                        region.max_x as usize - u
+                    };
+                    let from = (region.min_y as usize + v) * source.stride + physical_x;
+                    copy_cell(&source.read, from, &mut self.world.read, to);
+                    copy_cell(&source.write, from, &mut self.world.write, to);
+                    self.world.flow[to] = source.flow[from];
+                    self.world.dirty[to] = false;
+                    self.world.dirty_flags[to] = 0;
+                    self.touched.push((to, from));
+                }
+            }
+        }
+        debug_assert!(self.tasks.len() <= MAX_TASKS);
+        !self.tasks.is_empty()
+    }
+
+    fn execute(&mut self, elements: &ElementTable, diseases: &DiseaseTable, environment: FloatEnv) {
+        let _guard = environment.install();
+        for &cell in &self.tasks {
+            super::pressure_cell(&mut self.world, elements, diseases, &mut self.events, cell);
+        }
+    }
+
+    fn commit(&self, target: &mut PhysicsWorld, events: &mut EventQueues) {
+        for &(from, to) in &self.touched {
+            copy_cell(&self.world.write, from, &mut target.write, to);
+            target.flow[to] = self.world.flow[from];
+            if self.world.dirty[from] {
+                target.mark_dirty(to, self.world.dirty_flags[from]);
+                // Pressure emits only substance notifications. Final native
+                // canonicalization ignores their payload/order/multiplicity.
+                if let Some(public) = target.public_index(to) {
+                    events.substance_change(public as i32);
+                }
+            }
+        }
+    }
+}
+
+pub(super) fn try_run(
+    world: &mut PhysicsWorld,
+    elements: &ElementTable,
+    diseases: &DiseaseTable,
+    events: &mut EventQueues,
+    region: Region,
+) -> bool {
+    if region.max_x <= region.min_x || region.max_y <= region.min_y {
+        return false;
+    }
+    let width = (region.max_x - region.min_x) as usize;
+    let height = (region.max_y - region.min_y) as usize;
+    let environment = FloatEnv::capture();
+    if !environment.all_exceptions_masked() {
+        return false;
+    }
+    let Some(pool) = crate::parallel::pool(width * height) else {
+        return false;
+    };
+    run_with_pool(world, elements, diseases, events, region, environment, pool)
+}
+
+fn run_with_pool(
+    world: &mut PhysicsWorld,
+    elements: &ElementTable,
+    diseases: &DiseaseTable,
+    events: &mut EventQueues,
+    region: Region,
+    environment: FloatEnv,
+    pool: &rayon::ThreadPool,
+) -> bool {
+    // The coordinator stays on its calling simulation thread, leaving every
+    // pool worker available. A nested call retains the serial implementation.
+    if pool.current_thread_index().is_some() || pool.current_num_threads() > 8 {
+        return false;
+    }
+    let width = (region.max_x - region.min_x) as usize;
+    let height = (region.max_y - region.min_y) as usize;
+    let workers = pool.current_num_threads();
+    SCRATCH.with(|cache| {
+        let Ok(mut cache) = cache.try_borrow_mut() else {
+            return false;
+        };
+        let missing = workers.saturating_sub(cache.len());
+        if cache.try_reserve_exact(missing).is_err() {
+            return false;
+        }
+        while cache.len() < workers {
+            let Some(scratch) = Scratch::new(elements) else {
+                return false;
+            };
+            cache.push(scratch);
+        }
+        GRAPH.with(|graph| {
+            let Ok(mut graph) = graph.try_borrow_mut() else {
+                return false;
+            };
+            let bands = (width - 1 + 2 * (height - 1)) / BAND + 1;
+            if !graph.prepare(bands, height.div_ceil(ROWS)) {
+                return false;
+            }
+            let compute = |scratch: &mut Scratch| scratch.execute(elements, diseases, environment);
+            dag::run(
+                world, elements, events, region, pool, &mut cache, &mut graph, &compute,
+            );
+            true
+        })
+    })
+}
