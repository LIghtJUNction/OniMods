+#[cfg(all(target_arch = "x86_64", target_os = "linux"))]
+#[test]
+fn cleanup_fields_preserve_mxcsr_and_errno_in_512_environments() {
+    fn read_mxcsr() -> u32 {
+        let mut value = 0_u32;
+        unsafe {
+            std::arch::asm!("stmxcsr [{p}]", p = in(reg) &mut value,
+            options(nostack, preserves_flags));
+        }
+        value
+    }
+    fn write_mxcsr(value: u32) {
+        unsafe {
+            std::arch::asm!("ldmxcsr [{p}]", p = in(reg) &value,
+            options(nostack, preserves_flags));
+        }
+    }
+    unsafe extern "C" {
+        fn __errno_location() -> *mut std::ffi::c_int;
+    }
+    let original = FloatEnv::capture();
+    let _restore = original.install();
+    let base = read_mxcsr() & !0xffff;
+    for mask in [0x1f80, 0x1f00, 0x1e80, 0x1d80, 0x1b80, 0x1780, 0x0f80, 0] {
+        for rounding in [0, 0x2000, 0x4000, 0x6000] {
+            for denormals in [0, 0x40, 0x8000, 0x8040] {
+                for sticky in [0, 1, 0x20, 0x3f] {
+                    let requested = base | mask | rounding | denormals | sticky;
+                    for pattern in 0..3 {
+                        let mut ids = [0, 1, 254, 255, 1];
+                        let mut counts = match pattern {
+                            0 => [-1, 0, 1, i32::MAX, 0],
+                            1 => [0, -1, i32::MIN, 0, -1],
+                            _ => [1, 17, i32::MAX, 2, 1],
+                        };
+                        let mut infestation = [0, 255, 253, 254, 255];
+                        let mut growth =
+                            [0x7fa12345, 1, 0x80000000, 0xffa12345, 0x7f800000].map(f32::from_bits);
+                        let errno = unsafe { __errno_location() };
+                        unsafe {
+                            *errno = 33;
+                        }
+                        write_mxcsr(requested);
+                        cleanup_fields(&mut ids, &mut counts, &mut infestation, &mut growth);
+                        assert_eq!(read_mxcsr(), requested);
+                        assert_eq!(unsafe { *errno }, 33);
+                    }
+                }
+            }
+        }
+    }
+}
