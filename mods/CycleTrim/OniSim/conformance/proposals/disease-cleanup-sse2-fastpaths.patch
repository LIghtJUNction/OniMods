+#[test]
+fn cleanup_fields_match_all_lane_masks_and_infestation_bytes() {
+    let words = [
+        0, 0x80000000, 1, 0x80000001, 0x7f800000, 0xff800000, 0x7fc12345, 0x7fa12345, 0xffa12345,
+        0x3f800000, 0xbf800000, 0x7f7fffff,
+    ];
+    for mask in 0..16 {
+        for tick in 0..=255_u8 {
+            for shift in 0..words.len() {
+                let mut ids = [0_u8, 1, 254, 255];
+                let mut counts: [i32; 4] = std::array::from_fn(|i| {
+                    if mask & (1 << i) != 0 {
+                        [1, 17, i32::MAX, 64][i]
+                    } else {
+                        [0, -1, i32::MIN, -100][i]
+                    }
+                });
+                let mut infestation: [u8; 4] =
+                    std::array::from_fn(|i| tick.wrapping_add((i * 73) as u8));
+                let mut growth: [f32; 4] =
+                    std::array::from_fn(|i| f32::from_bits(words[(shift + i) % words.len()]));
+                let mut expected_ids = ids;
+                let mut expected_counts = counts;
+                let mut expected_infestation = infestation;
+                let mut expected_words = growth.map(f32::to_bits);
+                for i in 0..4 {
+                    if expected_counts[i] < 1 {
+                        expected_ids[i] = 255;
+                        expected_counts[i] = 0;
+                        expected_infestation[i] = 0;
+                        expected_words[i] = 0;
+                    }
+                    expected_infestation[i] = (expected_infestation[i] as u16 + 1).min(254) as u8;
+                }
+                cleanup_fields(&mut ids, &mut counts, &mut infestation, &mut growth);
+                assert_eq!(ids, expected_ids);
+                assert_eq!(counts, expected_counts);
+                assert_eq!(infestation, expected_infestation);
+                assert_eq!(growth.map(f32::to_bits), expected_words);
+            }
+        }
+    }
+}
