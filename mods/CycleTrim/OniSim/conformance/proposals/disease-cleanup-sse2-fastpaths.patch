+#[test]
+fn cleanup_fields_reject_unequal_lengths_before_writes() {
+    for short in 0..4 {
+        let mut ids = [1_u8; 4];
+        let mut counts = [-1_i32; 4];
+        let mut infestation = [255_u8; 4];
+        let mut growth = [f32::from_bits(0x7fa12345); 4];
+        let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            cleanup_fields(
+                &mut ids[..if short == 0 { 3 } else { 4 }],
+                &mut counts[..if short == 1 { 3 } else { 4 }],
+                &mut infestation[..if short == 2 { 3 } else { 4 }],
+                &mut growth[..if short == 3 { 3 } else { 4 }],
+            );
+        }));
+        assert!(result.is_err());
+        assert_eq!(ids, [1; 4]);
+        assert_eq!(counts, [-1; 4]);
+        assert_eq!(infestation, [255; 4]);
+        assert_eq!(growth.map(f32::to_bits), [0x7fa12345; 4]);
+    }
+}
