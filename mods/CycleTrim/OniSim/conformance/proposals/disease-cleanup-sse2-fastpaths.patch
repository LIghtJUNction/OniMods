+// Counts <= 0 clear all disease fields, then every cell advances infestation.
+// Positive counts preserve the exact growth word, including signaling NaNs.
+#[inline]
+fn cleanup_scalar(ids: &mut [u8], counts: &mut [i32], infestation: &mut [u8], growth: &mut [f32]) {
+    for (((id, count), infestation), growth) in
+        ids.iter_mut().zip(counts).zip(infestation).zip(growth)
+    {
+        if *count < 1 {
+            *id = u8::MAX;
+            *count = 0;
+            *infestation = 0;
+            *growth = 0.0;
+        }
+        *infestation = (*infestation as u16 + 1).min(254) as u8;
+    }
+}
+
+#[cfg(target_arch = "x86_64")]
+#[inline]
+fn cleanup_four(
+    ids: &mut [u8; 4],
+    counts: &mut [i32; 4],
+    infestation: &mut [u8; 4],
+    growth: &mut [f32; 4],
+) {
+    use std::arch::x86_64::*;
+    // SSE2 is guaranteed on x86_64. Array types bound every 16-byte and
+    // 4-byte unaligned access. Integer/bitwise operations preserve all FP words.
+    unsafe {
+        let zero = _mm_setzero_si128();
+        let old_counts = _mm_loadu_si128(counts.as_ptr().cast());
+        let keep = _mm_cmpgt_epi32(old_counts, zero);
+        let lanes = _mm_movemask_epi8(keep);
+        if lanes == 0 {
+            // Every lane takes the original count <= 0 branch; no old payload
+            // can contribute to the result, including NaN growth words.
+            _mm_storeu_si128(counts.as_mut_ptr().cast(), zero);
+            _mm_storeu_si128(growth.as_mut_ptr().cast(), zero);
+            ids.fill(u8::MAX);
+            infestation.fill(1);
+            return;
+        }
+        let old_ticks = std::ptr::read_unaligned(infestation.as_ptr().cast::<u32>());
+        let one = _mm_set1_epi8(1);
+        let tick = _mm_min_epu8(
+            _mm_adds_epu8(_mm_cvtsi32_si128(old_ticks as i32), one),
+            _mm_set1_epi8(-2),
+        );
+        if lanes == 0xffff {
+            // Every positive-count lane keeps its ID/count/growth verbatim.
+            // Avoid writing those unchanged arrays after the growth pass.
+            std::ptr::write_unaligned(
+                infestation.as_mut_ptr().cast::<u32>(),
+                _mm_cvtsi128_si32(tick) as u32,
+            );
+            return;
+        }
+        let keep_bytes = _mm_packs_epi16(_mm_packs_epi32(keep, zero), zero);
+        let old_growth = _mm_loadu_si128(growth.as_ptr().cast());
+        _mm_storeu_si128(counts.as_mut_ptr().cast(), _mm_and_si128(old_counts, keep));
+        _mm_storeu_si128(growth.as_mut_ptr().cast(), _mm_and_si128(old_growth, keep));
+        let old_ids = std::ptr::read_unaligned(ids.as_ptr().cast::<u32>());
+        let mask = _mm_cvtsi128_si32(keep_bytes) as u32;
+        std::ptr::write_unaligned(ids.as_mut_ptr().cast::<u32>(), old_ids | !mask);
+        let tick = _mm_or_si128(
+            _mm_and_si128(tick, keep_bytes),
+            _mm_andnot_si128(keep_bytes, one),
+        );
+        std::ptr::write_unaligned(
+            infestation.as_mut_ptr().cast::<u32>(),
+            _mm_cvtsi128_si32(tick) as u32,
+        );
+    }
+}
+
+#[inline]
+fn cleanup_fields(ids: &mut [u8], counts: &mut [i32], infestation: &mut [u8], growth: &mut [f32]) {
+    assert!(
+        ids.len() == counts.len() && ids.len() == infestation.len() && ids.len() == growth.len(),
+        "disease cleanup slices must share a length"
+    );
+    #[cfg(target_arch = "x86_64")]
+    {
+        let (id_blocks, id_tail) = ids.as_chunks_mut::<4>();
+        let (count_blocks, count_tail) = counts.as_chunks_mut::<4>();
+        let (infestation_blocks, infestation_tail) = infestation.as_chunks_mut::<4>();
+        let (growth_blocks, growth_tail) = growth.as_chunks_mut::<4>();
+        for (((ids, counts), infestation), growth) in id_blocks
+            .iter_mut()
+            .zip(count_blocks)
+            .zip(infestation_blocks)
+            .zip(growth_blocks)
+        {
+            cleanup_four(ids, counts, infestation, growth);
+        }
+        cleanup_scalar(id_tail, count_tail, infestation_tail, growth_tail);
+    }
+    #[cfg(not(target_arch = "x86_64"))]
+    cleanup_scalar(ids, counts, infestation, growth);
 }
 
