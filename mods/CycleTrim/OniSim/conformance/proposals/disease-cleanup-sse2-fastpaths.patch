+#[test]
+fn cleanup_fields_keep_unaligned_tails_and_outside_cells_exact() {
+    for offset in 0..8 {
+        for length in 0..38 {
+            let mut actual = fixture(64);
+            let mut expected = actual.clone();
+            for cell in offset..offset + length {
+                if expected.disease_count[cell] < 1 {
+                    expected.disease_idx[cell] = 255;
+                    expected.disease_count[cell] = 0;
+                    expected.disease_infestation[cell] = 0;
+                    expected.disease_growth[cell] = 0.0;
+                }
+                expected.disease_infestation[cell] =
+                    (expected.disease_infestation[cell] as u16 + 1).min(254) as u8;
+            }
+            let selected = offset..offset + length;
+            cleanup_fields(
+                &mut actual.disease_idx[selected.clone()],
+                &mut actual.disease_count[selected.clone()],
+                &mut actual.disease_infestation[selected.clone()],
+                &mut actual.disease_growth[selected],
+            );
+            equal(&actual, &expected);
+        }
+    }
+}
