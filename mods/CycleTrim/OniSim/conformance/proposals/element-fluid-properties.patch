+#[cfg(test)]
+mod fluid_properties_tests {
+    use super::*;
+
+    const WORDS: [u32; 12] = [
+        0, 0x80000000, 1, 0x80000001, 0x007fffff, 0x00800000, 0x3f800000, 0x7f800000, 0xff800000,
+        0x7f800001, 0x7fc12345, 0xff812345,
+    ];
+
+    fn encoded(count: usize) -> Vec<u8> {
+        let mut bytes = Vec::with_capacity(4 + count * (ELEMENT_BYTES + 4));
+        bytes.extend_from_slice(&(count as u32).to_le_bytes());
+        for i in 0..count {
+            let mut raw = [0; ELEMENT_BYTES];
+            // The lookup key is array position, not the independent wire index.
+            raw[8..10].copy_from_slice(&(!(i as u16)).to_le_bytes());
+            raw[10] = i as u8;
+            raw[36..40].copy_from_slice(&WORDS[i % WORDS.len()].to_le_bytes());
+            bytes.extend_from_slice(&raw);
+        }
+        bytes.resize(bytes.len() + count * 4, 0); // empty names
+        bytes
+    }
+
+    fn check(table: &ElementTable) {
+        assert_eq!(table.elements.fluid.len(), table.len());
+        for (i, element) in table.elements.iter().enumerate() {
+            let properties = table.fluid_properties(i as u16);
+            assert_eq!(table.phase(i as u16), element.record.state & 3);
+            assert_eq!(properties.phase, element.record.state & 3);
+            assert_eq!(properties.flow().to_bits(), element.record.flow.to_bits());
+            assert_eq!(properties.flow_bits, WORDS[i % WORDS.len()]);
+        }
+    }
+
+    #[test]
+    fn every_state_and_raw_flow_word_survives_parse_and_clone() {
+        let original = ElementTable::parse(&encoded(256 * WORDS.len())).unwrap();
+        check(&original);
+        let cloned = original.clone();
+        drop(original);
+        check(&cloned);
+        assert_eq!(std::mem::size_of::<FluidProperties>(), 8);
+    }
+
+    #[test]
+    fn full_u16_domain_includes_last_element() {
+        let table = ElementTable::parse(&encoded(MAX_ELEMENTS)).unwrap();
+        assert_eq!(table.len(), MAX_ELEMENTS);
+        check(&table);
+        assert_eq!(table.phase(u16::MAX), 3);
+    }
+
+    #[test]
+    fn replacement_and_empty_tables_keep_lookup_lengths_coherent() {
+        let mut table = ElementTable::parse(&encoded(7)).unwrap();
+        table.elements = ElementTable::parse(&encoded(13)).unwrap().elements;
+        check(&table);
+        table.elements = ElementRecords::default();
+        assert!(table.is_empty());
+        assert!(table.elements.fluid.is_empty());
+        check(&ElementTable::parse(&encoded(0)).unwrap());
+    }
+
+    #[test]
+    fn invalid_lookup_panics_instead_of_supplying_default_properties() {
+        for count in [0, 1, 17, 255] {
+            let table = ElementTable::parse(&encoded(count)).unwrap();
+            for invalid in [count as u16, u16::MAX] {
+                assert!(std::panic::catch_unwind(|| table.phase(invalid)).is_err());
+                assert!(std::panic::catch_unwind(|| table.fluid_properties(invalid)).is_err());
+                assert!(std::panic::catch_unwind(|| &table.elements[invalid as usize]).is_err());
+            }
+        }
+    }
