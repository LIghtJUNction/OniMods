+// Keep the records and their compact lookup together. No DerefMut is exposed:
+// callers cannot mutate a record and leave the derived properties stale.
+#[derive(Clone, Debug, Default)]
+pub(crate) struct ElementRecords {
+    records: Vec<Element>,
+    fluid: Vec<FluidProperties>,
+}
+
+impl std::ops::Deref for ElementRecords {
+    type Target = [Element];
+
+    fn deref(&self) -> &Self::Target {
+        &self.records
+    }
+}
+
