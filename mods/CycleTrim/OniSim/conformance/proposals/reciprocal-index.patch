+#[cfg(test)]
+fn index_world(width: u64, height: u64) -> crate::world::PhysicsWorld {
+    let ids = [0x2d39_bf75_u32, 0xa936_0b34, 0x6d95_058c];
+    let names = ["Vacuum", "Void", "Unobtanium"];
+    let mut bytes = (ids.len() as i32).to_le_bytes().to_vec();
+    for (index, id) in ids.into_iter().enumerate() {
+        let mut record = [0_u8; 164];
+        record[..4].copy_from_slice(&id.to_le_bytes());
+        record[8..10].copy_from_slice(&(index as u16).to_le_bytes());
+        record[10] = if index == 2 { 7 } else { 0 };
+        bytes.extend(record);
+    }
+    for name in names {
+        bytes.extend((name.len() as i32).to_le_bytes());
+        bytes.extend(name.as_bytes());
+    }
+    let elements = crate::tables::ElementTable::parse(&bytes).unwrap();
+    crate::world::PhysicsWorld::new(width as usize, height as usize, 42, &elements)
+        .unwrap_or_else(|_| panic!("Authored index world failed to initialize"))
+}
+
+#[test]
+fn padded_grid_conversion_preserves_original_signed_semantics() {
+    let mut random = 0x1234_5678_9abc_def0_u64;
+    for (width, height) in [(1, 1), (2, 19), (63, 65), (96, 96), (256, 128), (736, 304)] {
+        let stride = width + 2;
+        let count = width * height;
+        let world = index_world(width, height);
+        for cell in 0..stride * (height + 2) {
+            assert_eq!(crate::fluid_helpers::game_index(&world, cell as usize), original_index(cell, stride, count));
+        }
+        for cell in [0, u64::MAX, i64::MAX as u64, 1_u64 << 63] {
+            assert_eq!(crate::fluid_helpers::game_index(&world, cell as usize), original_index(cell, stride, count));
+        }
+        for _ in 0..100_000 {
+            let cell = next(&mut random);
+            assert_eq!(crate::fluid_helpers::game_index(&world, cell as usize), original_index(cell, stride, count));
+        }
+    }
+}
