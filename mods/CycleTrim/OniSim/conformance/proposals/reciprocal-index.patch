+#![forbid(unsafe_code)]
+
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct ReciprocalDivisor {
+    divisor: u64,
+    multiplier: u64,
+}
+
+impl ReciprocalDivisor {
+    pub(crate) fn new(divisor: u64) -> Option<Self> {
+        if divisor < 2 {
+            return None;
+        }
+        Some(Self {
+            divisor,
+            multiplier: ((1_u128 << 64) / u128::from(divisor)) as u64,
+        })
+    }
+
+    #[inline]
+    pub(crate) fn div_rem(self, value: u64) -> (u64, u64) {
+        let estimate = ((u128::from(value) * u128::from(self.multiplier)) >> 64) as u64;
+        let remainder = value - estimate * self.divisor;
+        if remainder >= self.divisor {
+            (estimate + 1, remainder - self.divisor)
+        } else {
+            (estimate, remainder)
+        }
+    }
+}
+
+#[cfg(test)]
+fn original_index(cell: u64, stride: u64, count: u64) -> Option<i32> {
+    let cell = cell as i64;
+    let stride = stride as i64;
+    let index = (cell / stride - 1) * (stride - 2) + cell % stride - 1;
+    (index >= 0 && index < count as i64).then_some(index as i32)
+}
+
+#[cfg(test)]
+fn next(value: &mut u64) -> u64 {
+    *value ^= *value << 13;
+    *value ^= *value >> 7;
+    *value ^= *value << 17;
+    *value
+}
+
+#[test]
+fn domain_and_boundaries() {
+    assert!(ReciprocalDivisor::new(0).is_none());
+    assert!(ReciprocalDivisor::new(1).is_none());
+    assert_eq!(std::mem::size_of::<ReciprocalDivisor>(), 16);
+    for d in [2, 3, 7, 31, 64, 65, 98, 306, 738, 1026, 2048,
+              u32::MAX as u64, i64::MAX as u64, u64::MAX] {
+        let divisor = ReciprocalDivisor::new(d).unwrap();
+        for n in [0, 1, d - 1, d, d.saturating_add(1), u64::MAX - 1, u64::MAX,
+                  (1_u64 << 63) - 1, 1_u64 << 63, (1_u64 << 63) + 1] {
+            assert_eq!(divisor.div_rem(n), (n / d, n % d), "n={n}, d={d}");
+        }
+    }
+}
+
+#[test]
+fn two_million_generated_unsigned_divisions() {
+    let mut random = 0x9e37_79b9_7f4a_7c15_u64;
+    for _ in 0..2_000_000 {
+        let n = next(&mut random);
+        let d = next(&mut random) | 2;
+        let divisor = ReciprocalDivisor::new(d).unwrap();
+        assert_eq!(divisor.div_rem(n), (n / d, n % d));
+    }
+}
