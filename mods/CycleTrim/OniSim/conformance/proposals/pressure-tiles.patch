+fn retained_bytes(s: &Scratch) -> usize {
+    fn bytes<T>(v: &Vec<T>) -> usize {
+        v.capacity() * std::mem::size_of::<T>()
+    }
+    fn cells(c: &Cells) -> usize {
+        bytes(&c.element)
+            + bytes(&c.temperature)
+            + bytes(&c.mass)
+            + bytes(&c.properties)
+            + bytes(&c.insulation)
+            + bytes(&c.strength)
+            + bytes(&c.disease_idx)
+            + bytes(&c.disease_count)
+            + bytes(&c.disease_infestation)
+            + bytes(&c.disease_growth)
+            + bytes(&c.radiation)
+    }
+    let w = &s.world;
+    std::mem::size_of::<Scratch>()
+        + cells(&w.read)
+        + cells(&w.write)
+        + bytes(&w.backwall_element)
+        + bytes(&w.backwall_mass)
+        + bytes(&w.backwall_temperature)
+        + bytes(&w.flow)
+        + bytes(&w.accumulated_flow)
+        + bytes(&w.radiation_transmission)
+        + w.inactive_mask.as_ref().map_or(0, bytes)
+        + bytes(&w.dirty)
+        + bytes(&w.dirty_flags)
+        + bytes(&w.regions)
+        + bytes(&w.world_offsets)
+        + bytes(&w.active_mask)
+        + bytes(&s.tasks)
+        + bytes(&s.touched)
+        + bytes(&s.marks)
+        + s.events
+            .storage_ranges()
+            .iter()
+            .map(|(_, size)| size)
+            .sum::<usize>()
+}
