+#[test]
+fn cleanup_slices_preserve_positive_counts_float_words_and_partial_rows() {
+    let stride = 259;
+    let height = 137;
+    for bounds in [
+        (0, stride, 0, height),
+        (3, 251, 2, 131),
+        (1, 2, 1, height),
+        (0, 0, 0, height),
+    ] {
+        let mut actual = fixture(stride * height);
+        actual.disease_idx.fill(u8::MAX);
+        let mut expected = actual.clone();
+        let (min_x, max_x, min_y, max_y) = bounds;
+        for y in min_y..max_y {
+            for x in min_x..max_x {
+                let cell = y * stride + x;
+                if expected.disease_count[cell] < 1 {
+                    expected.disease_count[cell] = 0;
+                    expected.disease_growth[cell] = 0.0;
+                    expected.disease_infestation[cell] = 0;
+                }
+                expected.disease_infestation[cell] =
+                    (expected.disease_infestation[cell] as u16 + 1).min(254) as u8;
+            }
+        }
+        cleanup_region(&mut actual, stride, bounds);
+        equal(&actual, &expected);
+    }
+}
