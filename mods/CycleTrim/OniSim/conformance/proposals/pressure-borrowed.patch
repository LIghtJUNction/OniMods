+//! Disjoint row borrows for the pressure stencil. Physics cells stay in their
+//! original SOA allocations; only slice headers and notification indices move.
+use std::cell::RefCell;
+use std::ops::{Index, IndexMut};
+
+use rayon::prelude::*;
+
+use crate::events::EventQueues;
+use crate::float_env::FloatEnv;
+use crate::tables::{DiseaseTable, ElementTable};
+use crate::world::{Cells, PhysicsWorld, Region};
+
+#[path = "pressure_borrowed_kernel.rs"]
+mod kernel;
+
+const BAND: usize = 32;
+const SOURCE_ROWS: usize = 16;
+const ROWS: usize = SOURCE_ROWS + 1;
+const TILES: usize = 8;
+const RANGES: usize = ROWS * TILES;
+const NOTIFICATIONS: usize = 3 * BAND * SOURCE_ROWS;
+
+#[derive(Clone, Copy)]
+struct Coord {
+    global: usize,
+    row: usize,
+}
+
+impl Coord {
+    #[inline]
+    fn side(self, direction: i32) -> Self {
+        Self {
+            global: self.global.wrapping_add_signed(direction as isize),
+            row: self.row,
+        }
+    }
+    #[inline]
+    fn upper(self, stride: usize) -> Self {
+        Self {
+            global: self.global + stride,
+            row: self.row + 1,
+        }
+    }
+}
+
+struct Read<'a, T>(&'a [T]);
+impl<T> Index<Coord> for Read<'_, T> {
+    type Output = T;
+    #[inline]
+    fn index(&self, cell: Coord) -> &T {
+        &self.0[cell.global]
+    }
+}
+
+struct ReadView<'a> {
+    element: Read<'a, u16>,
+    mass: Read<'a, f32>,
+    properties: Read<'a, u8>,
+    disease_count: Read<'a, i32>,
+}
+impl<'a> ReadView<'a> {
+    fn new(cells: &'a Cells) -> Self {
+        Self {
+            element: Read(&cells.element),
+            mass: Read(&cells.mass),
+            properties: Read(&cells.properties),
+            disease_count: Read(&cells.disease_count),
+        }
+    }
+}
+
+#[derive(Clone, Copy, Default)]
+struct Interval {
+    start: usize,
+    end: usize,
+}
+impl Interval {
+    fn is_empty(self) -> bool {
+        self.start >= self.end
+    }
+}
+
+#[derive(Clone, Copy)]
+struct Plan {
+    first_y: usize,
+    source: [Interval; SOURCE_ROWS],
+    starts: [usize; ROWS],
+    lengths: [usize; ROWS],
+}
+impl Default for Plan {
+    fn default() -> Self {
+        Self {
+            first_y: 0,
+            source: [Interval::default(); SOURCE_ROWS],
+            starts: [0; ROWS],
+            lengths: [0; ROWS],
+        }
+    }
+}
+
+impl Plan {
+    fn new(
+        region: Region,
+        stride: usize,
+        direction: i32,
+        band: usize,
+        row_band: usize,
+    ) -> Option<Self> {
+        let width = (region.max_x - region.min_x) as usize;
+        let height = (region.max_y - region.min_y) as usize;
+        let mut plan = Self {
+            first_y: row_band * SOURCE_ROWS,
+            ..Self::default()
+        };
+        for (row, interval) in plan.source.iter_mut().enumerate() {
+            let y = plan.first_y + row;
+            if y >= height {
+                continue;
+            }
+            *interval = Interval {
+                start: (band * BAND).saturating_sub(2 * y),
+                end: ((band + 1) * BAND).saturating_sub(2 * y).min(width),
+            };
+        }
+        if plan.source.iter().all(|r| r.is_empty()) {
+            return None;
+        }
+        for row in 0..ROWS {
+            let current = plan.source.get(row).copied().filter(|r| !r.is_empty());
+            let previous = row
+                .checked_sub(1)
+                .and_then(|r| plan.source.get(r))
+                .copied()
+                .filter(|r| !r.is_empty());
+            let mut start = usize::MAX;
+            let mut end = 0;
+            for interval in [current, previous].into_iter().flatten() {
+                start = start.min(interval.start);
+                end = end.max(interval.end + 1);
+            }
+            if start == usize::MAX {
+                continue;
+            }
+            let physical_x = if direction > 0 {
+                region.min_x as usize + start
+            } else {
+                region.max_x as usize - (end - 1)
+            };
+            plan.starts[row] = (region.min_y as usize + plan.first_y + row) * stride + physical_x;
+            plan.lengths[row] = end - start;
+        }
+        Some(plan)
+    }
+}
+
+#[derive(Clone, Copy, Default)]
+struct Range {
+    start: usize,
+    len: usize,
+    tile: usize,
+    row: usize,
+}
+
+fn ranges(plans: &[Plan; TILES], count: usize) -> ([Range; RANGES], usize) {
+    let mut result = [Range::default(); RANGES];
+    let mut used = 0;
+    for (tile, plan) in plans[..count].iter().enumerate() {
+        for row in 0..ROWS {
+            if plan.lengths[row] == 0 {
+                continue;
+            }
+            result[used] = Range {
+                start: plan.starts[row],
+                len: plan.lengths[row],
+                tile,
+                row,
+            };
+            used += 1;
+        }
+    }
+    result[..used].sort_unstable_by_key(|r| r.start);
+    let mut end = 0;
+    for range in &result[..used] {
+        assert!(range.start >= end, "Pressure tile row borrows overlap");
+        end = range.start + range.len;
+    }
+    (result, used)
+}
+
+struct Rows<'a, T> {
+    plan: &'a Plan,
+    data: [&'a mut [T]; ROWS],
+}
+impl<T> Index<Coord> for Rows<'_, T> {
+    type Output = T;
+    #[inline]
+    fn index(&self, cell: Coord) -> &T {
+        &self.data[cell.row][cell.global - self.plan.starts[cell.row]]
+    }
+}
+impl<T> IndexMut<Coord> for Rows<'_, T> {
+    #[inline]
+    fn index_mut(&mut self, cell: Coord) -> &mut T {
+        &mut self.data[cell.row][cell.global - self.plan.starts[cell.row]]
+    }
+}
+
+fn borrow_rows<'a, T>(
+    data: &'a mut [T],
+    order: &[Range],
+    plans: &'a [Plan; TILES],
+) -> [Option<Rows<'a, T>>; TILES] {
+    let mut result = std::array::from_fn(|tile| {
+        Some(Rows {
+            plan: &plans[tile],
+            data: std::array::from_fn(|_| &mut [] as &mut [T]),
+        })
+    });
+    let mut tail = data;
+    let mut end = 0;
+    for range in order {
+        let (_, from) = tail.split_at_mut(range.start - end);
+        let (row, rest) = from.split_at_mut(range.len);
+        result[range.tile].as_mut().unwrap().data[range.row] = row;
+        tail = rest;
+        end = range.start + range.len;
+    }
+    result
+}
+
+struct WriteView<'a> {
+    element: Rows<'a, u16>,
+    mass: Rows<'a, f32>,
+    temperature: Rows<'a, f32>,
+    disease_idx: Rows<'a, u8>,
+    disease_count: Rows<'a, i32>,
+    disease_infestation: Rows<'a, u8>,
+    disease_growth: Rows<'a, f32>,
+}
+struct View<'a> {
+    read: ReadView<'a>,
+    write: WriteView<'a>,
+    flow: Rows<'a, [f32; 4]>,
+    dirty: Rows<'a, bool>,
+    dirty_flags: Rows<'a, u8>,
+    stride: usize,
+    width: usize,
+    height: usize,
+    scan_direction: i32,
+    sink_element: u16,
+}
+
+fn execute(
+    view: &mut View<'_>,
+    plan: &Plan,
+    region: Region,
+    elements: &ElementTable,
+    diseases: &DiseaseTable,
+    events: &mut Vec<i32>,
+    environment: FloatEnv,
+) {
+    let _guard = environment.install();
+    for (row, source) in plan.source.iter().enumerate() {
+        let y = region.min_y as usize + plan.first_y + row;
+        for u in source.start..source.end {
+            let x = if view.scan_direction > 0 {
+                region.min_x as usize + u
+            } else {
+                region.max_x as usize - u
+            };
+            kernel::pressure_cell(
+                view,
+                elements,
+                diseases,
+                events,
+                Coord {
+                    global: y * view.stride + x,
+                    row,
+                },
+            );
+        }
+    }
+}
+
+fn batch(
+    world: &mut PhysicsWorld,
+    elements: &ElementTable,
+    diseases: &DiseaseTable,
+    region: Region,
+    pool: &rayon::ThreadPool,
+    plans: &[Plan; TILES],
+    count: usize,
+    events: &mut [Vec<i32>],
+    environment: FloatEnv,
+) {
+    let (order, used) = ranges(plans, count);
+    let order = &order[..used];
+    let (stride, width, height, direction, sink) = (
+        world.stride,
+        world.width,
+        world.height,
+        world.scan_direction,
+        world.sink_element,
+    );
+    let read = &world.read;
+    let mut element = borrow_rows(&mut world.write.element, order, plans);
+    let mut mass = borrow_rows(&mut world.write.mass, order, plans);
+    let mut temperature = borrow_rows(&mut world.write.temperature, order, plans);
+    let mut disease_idx = borrow_rows(&mut world.write.disease_idx, order, plans);
+    let mut disease_count = borrow_rows(&mut world.write.disease_count, order, plans);
+    let mut infestation = borrow_rows(&mut world.write.disease_infestation, order, plans);
+    let mut growth = borrow_rows(&mut world.write.disease_growth, order, plans);
+    let mut flow = borrow_rows(&mut world.flow, order, plans);
+    let mut dirty = borrow_rows(&mut world.dirty, order, plans);
+    let mut flags = borrow_rows(&mut world.dirty_flags, order, plans);
+    let mut views: [View<'_>; TILES] = std::array::from_fn(|i| View {
+        read: ReadView::new(read),
+        write: WriteView {
+            element: element[i].take().unwrap(),
+            mass: mass[i].take().unwrap(),
+            temperature: temperature[i].take().unwrap(),
+            disease_idx: disease_idx[i].take().unwrap(),
+            disease_count: disease_count[i].take().unwrap(),
+            disease_infestation: infestation[i].take().unwrap(),
+            disease_growth: growth[i].take().unwrap(),
+        },
+        flow: flow[i].take().unwrap(),
+        dirty: dirty[i].take().unwrap(),
+        dirty_flags: flags[i].take().unwrap(),
+        stride,
+        width,
+        height,
+        scan_direction: direction,
+        sink_element: sink,
+    });
+    for events in &mut events[..count] {
+        events.clear();
+    }
+    if count == 1 {
+        execute(
+            &mut views[0],
+            &plans[0],
+            region,
+            elements,
+            diseases,
+            &mut events[0],
+            environment,
+        );
+    } else {
+        pool.install(|| {
+            views[..count]
+                .par_iter_mut()
+                .zip(events[..count].par_iter_mut())
+                .enumerate()
+                .for_each(|(i, (view, events))| {
+                    execute(
+                        view,
+                        &plans[i],
+                        region,
+                        elements,
+                        diseases,
+                        events,
+                        environment,
+                    )
+                })
+        });
+    }
+}
+
+thread_local! {
+    static EVENTS: RefCell<Vec<Vec<i32>>> = const { RefCell::new(Vec::new()) };
+}
+
+pub(super) fn try_run(
+    world: &mut PhysicsWorld,
+    elements: &ElementTable,
+    diseases: &DiseaseTable,
+    events: &mut EventQueues,
+    region: Region,
+) -> bool {
+    if region.max_x <= region.min_x || region.max_y <= region.min_y {
+        return false;
+    }
+    let width = (region.max_x - region.min_x) as usize;
+    let height = (region.max_y - region.min_y) as usize;
+    let Some(pool) = crate::parallel::pool(width * height) else {
+        return false;
+    };
+    run_with_pool(world, elements, diseases, events, region, pool)
+}
+
+fn run_with_pool(
+    world: &mut PhysicsWorld,
+    elements: &ElementTable,
+    diseases: &DiseaseTable,
+    events: &mut EventQueues,
+    region: Region,
+    pool: &rayon::ThreadPool,
+) -> bool {
+    let environment = FloatEnv::capture();
+    let workers = pool.current_num_threads();
+    if workers <= 1 || workers > TILES || !environment.all_exceptions_masked() {
+        return false;
+    }
+    let any_work = (region.min_y..region.max_y).any(|y| {
+        let first = if world.scan_direction > 0 {
+            region.min_x
+        } else {
+            region.min_x + 1
+        };
+        let end = if world.scan_direction > 0 {
+            region.max_x
+        } else {
+            region.max_x + 1
+        };
+        (first..end).any(|x| {
+            let cell = y as usize * world.stride + x as usize;
+            world.read.properties[cell] & 1 == 0
+                && elements.elements[world.read.element[cell] as usize]
+                    .record
+                    .state
+                    & 2
+                    == 0
+        })
+    });
+    if !any_work {
+        return true;
+    }
+    let width = (region.max_x - region.min_x) as usize;
+    let height = (region.max_y - region.min_y) as usize;
+    let bands = (width - 1 + 2 * (height - 1)) / BAND + 1;
+    let row_bands = height.div_ceil(SOURCE_ROWS);
+    EVENTS.with(|cache| {
+        let Ok(mut cache) = cache.try_borrow_mut() else {
+            return false;
+        };
+        let missing = workers.saturating_sub(cache.len());
+        if cache.try_reserve_exact(missing).is_err() {
+            return false;
+        }
+        while cache.len() < workers {
+            let mut list = Vec::new();
+            if list.try_reserve_exact(NOTIFICATIONS).is_err() {
+                return false;
+            }
+            cache.push(list);
+        }
+        let mut plans = [Plan::default(); TILES];
+        let mut count = 0;
+        for level in 0..bands + row_bands - 1 {
+            for band in level.saturating_sub(row_bands - 1)..=level.min(bands - 1) {
+                let Some(plan) = Plan::new(
+                    region,
+                    world.stride,
+                    world.scan_direction,
+                    band,
+                    level - band,
+                ) else {
+                    continue;
+                };
+                plans[count] = plan;
+                count += 1;
+                if count == workers {
+                    batch(
+                        world,
+                        elements,
+                        diseases,
+                        region,
+                        pool,
+                        &plans,
+                        count,
+                        &mut cache[..count],
+                        environment,
+                    );
+                    for list in &cache[..count] {
+                        for &cell in list {
+                            events.substance_change(cell);
+                        }
+                    }
+                    count = 0;
+                }
+            }
+            if count != 0 {
+                batch(
+                    world,
+                    elements,
+                    diseases,
+                    region,
+                    pool,
+                    &plans,
+                    count,
+                    &mut cache[..count],
+                    environment,
+                );
+                for list in &cache[..count] {
+                    for &cell in list {
+                        events.substance_change(cell);
+                    }
+                }
+                count = 0;
+            }
+        }
+        true
+    })
+}
