+use super::{Coord, View, WriteView};
+use crate::fluid_helpers::{add_disease_fields, cvtt, smax, smin};
+use crate::tables::{DiseaseTable, ElementTable};
+
+fn old_phase(world: &View<'_>, elements: &ElementTable, cell: Coord) -> u8 {
+    elements.elements[world.read.element[cell] as usize]
+        .record
+        .state
+        & 3
+}
+
+fn pressure_target(
+    world: &View<'_>,
+    elements: &ElementTable,
+    source_element: u16,
+    source_phase: u8,
+    cell: Coord,
+) -> bool {
+    let element = world.read.element[cell];
+    let state = elements.elements[element as usize].record.state;
+    world.read.properties[cell] & 1 == 0
+        && world.write.element[cell] == element
+        && state & 2 == 0
+        && (state & 3 != source_phase || element == source_element)
+}
+
+pub(super) fn pressure_cell(
+    world: &mut View<'_>,
+    elements: &ElementTable,
+    diseases: &DiseaseTable,
+    events: &mut Vec<i32>,
+    cell: Coord,
+) {
+    let element = world.read.element[cell];
+    let record = &elements.elements[element as usize].record;
+    let source_phase = record.state & 3;
+    let coefficient = record.flow;
+    if world.read.properties[cell] & 1 != 0
+        || world.write.element[cell] != element
+        || record.state & 2 != 0
+    {
+        return;
+    }
+    let direction = world.scan_direction;
+    let side = cell.side(direction);
+    let horizontal = if pressure_target(world, elements, element, source_phase, side) {
+        direction as f32
+            * update_pressure(
+                world,
+                elements,
+                diseases,
+                events,
+                cell,
+                element,
+                source_phase,
+                coefficient,
+                side,
+            )
+    } else {
+        0.0
+    };
+    world.flow[cell][1] += horizontal;
+    world.flow[side][0] -= horizontal;
+    let upper = cell.upper(world.stride);
+    let vertical = if world.write.element[cell] == element
+        && pressure_target(world, elements, element, source_phase, upper)
+    {
+        update_pressure(
+            world,
+            elements,
+            diseases,
+            events,
+            cell,
+            element,
+            source_phase,
+            coefficient,
+            upper,
+        )
+    } else {
+        0.0
+    };
+    world.flow[cell][2] += vertical;
+    world.flow[upper][3] -= vertical;
+    if (old_phase(world, elements, upper) | old_phase(world, elements, side)) != 3
+        && world.write.element[cell] == element
+        && pressure_target(
+            world,
+            elements,
+            element,
+            source_phase,
+            side.upper(world.stride),
+        )
+    {
+        update_pressure(
+            world,
+            elements,
+            diseases,
+            events,
+            cell,
+            element,
+            source_phase,
+            coefficient,
+            side.upper(world.stride),
+        );
+    }
+}
+
+fn update_pressure(
+    world: &mut View<'_>,
+    tables: &ElementTable,
+    diseases: &DiseaseTable,
+    events: &mut Vec<i32>,
+    a: Coord,
+    element_a: u16,
+    phase_a: u8,
+    coefficient: f32,
+    b: Coord,
+) -> f32 {
+    let element_b = world.read.element[b];
+    let record_b = &tables.elements[element_b as usize].record;
+    let ma = world.read.mass[a];
+    let mb = world.read.mass[b];
+    let coefficient = if phase_a == 1 {
+        coefficient
+    } else {
+        record_b.flow
+    };
+    let flow = smax(smin(coefficient * (ma - mb), 0.125 * ma), -0.125 * mb);
+    let (src, dst, old_mass, amount, source_element, dest_element, dest_phase) = if flow < 0.0 {
+        (b, a, mb, -flow, element_b, element_a, phase_a)
+    } else {
+        (a, b, ma, flow, element_a, element_b, record_b.state & 3)
+    };
+    let amount = smin(amount, old_mass);
+    let fraction = smax(smin(amount / old_mass, 1.0), 0.0);
+    let germ_count = cvtt(world.read.disease_count[src] as f32 * fraction);
+    let germ_id = world.write.disease_idx[src];
+    let source_temperature = world.write.temperature[src];
+    let dest_temperature = world.write.temperature[dst];
+    let dest_mass = world.write.mass[dst];
+    let combined_mass = dest_mass + amount;
+    let temperature = if combined_mass <= 0.0 {
+        0.0
+    } else {
+        let weighted = (dest_mass * dest_temperature + source_temperature * amount) / combined_mass;
+        if dest_temperature > source_temperature {
+            if weighted < source_temperature || weighted.is_nan() || source_temperature.is_nan() {
+                source_temperature
+            } else {
+                smin(dest_temperature, weighted)
+            }
+        } else if dest_temperature <= weighted {
+            smin(source_temperature, weighted)
+        } else {
+            dest_temperature
+        }
+    };
+    world.write.mass[dst] = combined_mass;
+    world.write.temperature[dst] = temperature;
+    add_disease(&mut world.write, diseases, dst, germ_id, germ_count);
+    world.write.mass[src] = smax(world.write.mass[src] - amount, 0.0);
+    let remaining = world.write.disease_count[src].wrapping_sub(germ_count);
+    world.write.disease_count[src] = remaining;
+    if remaining <= 0 {
+        clear_disease(&mut world.write, src);
+    }
+    if dest_phase == 0 {
+        if dest_element == world.sink_element {
+            world.write.mass[dst] = 0.0;
+            world.write.temperature[dst] = 0.0;
+            clear_disease(&mut world.write, dst);
+        } else {
+            world.write.element[dst] = source_element;
+            notify(world, events, dst);
+        }
+    }
+    flow
+}
+
+fn add_disease(
+    cells: &mut WriteView<'_>,
+    tables: &DiseaseTable,
+    cell: Coord,
+    disease: u8,
+    count: i32,
+) {
+    add_disease_fields(
+        tables,
+        &mut cells.disease_idx[cell],
+        &mut cells.disease_count[cell],
+        &mut cells.disease_infestation[cell],
+        &mut cells.disease_growth[cell],
+        disease,
+        count,
+    );
+}
+fn clear_disease(cells: &mut WriteView<'_>, cell: Coord) {
+    cells.disease_idx[cell] = 255;
+    cells.disease_count[cell] = 0;
+    cells.disease_infestation[cell] = 0;
+    cells.disease_growth[cell] = 0.0;
+}
+fn notify(world: &mut View<'_>, events: &mut Vec<i32>, cell: Coord) {
+    let stride = world.stride as i64;
+    let global = cell.global as i64;
+    let index = (global / stride - 1) * (stride - 2) + global % stride - 1;
+    if index >= 0 && index < (world.width * world.height) as i64 {
+        events.push(index as i32);
+    }
+    world.dirty[cell] = true;
+    world.dirty_flags[cell] |= 0x1f;
+}
