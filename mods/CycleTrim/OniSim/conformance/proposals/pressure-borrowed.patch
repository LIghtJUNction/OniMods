+fn elements() -> ElementTable {
+    let mut bytes = 4_i32.to_le_bytes().to_vec();
+    for (index, hash) in [0xa9360b34_u32, 0x2d39bf75, 0x6d95058c, 0x12345678]
+        .into_iter()
+        .enumerate()
+    {
+        let mut record = [0_u8; 164];
+        record[..4].copy_from_slice(&hash.to_le_bytes());
+        record[8..10].copy_from_slice(&(index as u16).to_le_bytes());
+        record[10] = [0, 0, 3, 1][index];
+        record[36..40].copy_from_slice(&0.25_f32.to_le_bytes());
+        bytes.extend_from_slice(&record);
+    }
+    bytes.extend_from_slice(&[0; 16]);
+    ElementTable::parse(&bytes).unwrap()
+}
+
+fn diseases() -> DiseaseTable {
+    let range = RangeInfo {
+        min_viable: 0.0,
+        min_growth: 0.0,
+        max_growth: 0.0,
+        max_viable: 0.0,
+    };
+    DiseaseTable {
+        element_count: 4,
+        diseases: (0..2)
+            .map(|id| Disease {
+                name: String::new(),
+                raw_header: [0; 76],
+                hash: id,
+                strength: (id + 1) as f32,
+                temperature_range: range.clone(),
+                temperature_half_lives: range.clone(),
+                pressure_range: range.clone(),
+                pressure_half_lives: range.clone(),
+                radiation_kill_rate: 0.0,
+                elements: Vec::new(),
+            })
+            .collect(),
+    }
+}
