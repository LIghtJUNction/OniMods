+#[test]
+fn row_borrows_preserve_original_addresses_and_only_mutate_their_ranges() {
+    let region = Region {
+        min_x: 3,
+        max_x: 140,
+        min_y: 5,
+        max_y: 40,
+        ..Region::default()
+    };
+    let mut plans = [Plan::default(); TILES];
+    plans[0] = Plan::new(region, 256, -1, 2, 0).unwrap();
+    plans[1] = Plan::new(region, 256, -1, 1, 1).unwrap();
+    let (order, used) = ranges(&plans, 2);
+    let order = &order[..used];
+    let mut values: Vec<u32> = (0..256 * 64).collect();
+    let base = values.as_ptr() as usize;
+    let mut touched = vec![false; values.len()];
+    {
+        let mut rows = borrow_rows(&mut values, order, &plans);
+        for range in order {
+            for global in range.start..range.start + range.len {
+                let cell = Coord {
+                    global,
+                    row: range.row,
+                };
+                let view = rows[range.tile].as_mut().unwrap();
+                assert_eq!(
+                    (&view[cell]) as *const u32 as usize,
+                    base + global * std::mem::size_of::<u32>()
+                );
+                view[cell] = u32::MAX;
+                touched[global] = true;
+            }
+        }
+    }
+    for (i, &value) in values.iter().enumerate() {
+        assert_eq!(value, if touched[i] { u32::MAX } else { i as u32 });
+    }
+}
