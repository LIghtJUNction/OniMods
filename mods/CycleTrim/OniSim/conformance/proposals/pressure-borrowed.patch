+fn fixture(elements: &ElementTable, direction: i32, seed: usize) -> PhysicsWorld {
+    let mut world =
+        PhysicsWorld::new(137, 79, 42, elements).unwrap_or_else(|e| panic!("{}", e.message));
+    for cell in 0..world.write.mass.len() {
+        let n = cell.wrapping_mul(17).wrapping_add(seed);
+        let x = cell % world.stride;
+        let y = cell / world.stride;
+        world.write.element[cell] =
+            if x == 0 || x == world.stride - 1 || y == 0 || y == world.padded_height - 1 {
+                2
+            } else if n % 11 == 0 {
+                1
+            } else {
+                3
+            };
+        world.write.mass[cell] = [0.0, 0.001, 1.0, 4.0, 1000.0, f32::from_bits(1), -0.0][n % 7];
+        world.write.temperature[cell] =
+            [0.0, 1.0, 273.15, 300.0, 1000.0, f32::from_bits(0x7fc12345)][n % 6];
+        world.write.properties[cell] = u8::from(n % 43 == 0);
+        world.write.disease_idx[cell] = [0, 1, 255][n % 3];
+        world.write.disease_count[cell] = [0, 1, 7, 10000, i32::MAX][n % 5];
+        world.write.disease_growth[cell] = f32::from_bits((n as u32).wrapping_mul(123457));
+        world.write.disease_infestation[cell] = n as u8;
+        world.flow[cell] = [n as f32 * 0.01; 4];
+        world.dirty[cell] = n % 7 == 0;
+        world.dirty_flags[cell] = (n % 32) as u8;
+    }
+    world.read.copy_from(&world.write);
+    world.scan_direction = direction;
+    world
+}
+
+fn equal(actual: &PhysicsWorld, expected: &PhysicsWorld) {
+    let a = &actual.write;
+    let e = &expected.write;
+    assert_eq!(a.element, e.element);
+    assert_eq!(a.disease_idx, e.disease_idx);
+    assert_eq!(a.disease_count, e.disease_count);
+    assert_eq!(a.disease_infestation, e.disease_infestation);
+    assert_eq!(a.properties, e.properties);
+    for (a, e) in [
+        (&a.mass, &e.mass),
+        (&a.temperature, &e.temperature),
+        (&a.disease_growth, &e.disease_growth),
+    ] {
+        assert!(a.iter().zip(e).all(|(a, e)| a.to_bits() == e.to_bits()));
+    }
+    assert!(
+        actual
+            .flow
+            .iter()
+            .flatten()
+            .zip(expected.flow.iter().flatten())
+            .all(|(a, e)| a.to_bits() == e.to_bits())
+    );
+    assert_eq!(actual.dirty, expected.dirty);
+    assert_eq!(actual.dirty_flags, expected.dirty_flags);
+}
+
+fn ids(events: &EventQueues) -> Vec<i32> {
+    let mut ids: Vec<_> = events
+        .substance_change_info
+        .iter()
+        .map(|e| e.cell_idx)
+        .collect();
+    ids.sort_unstable();
+    ids.dedup();
+    ids
+}
