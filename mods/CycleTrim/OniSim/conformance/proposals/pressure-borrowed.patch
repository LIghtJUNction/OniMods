+#[test]
+fn row_plans_cover_exact_stencils_and_same_level_tiles_are_disjoint() {
+    use std::collections::HashSet;
+    let stride = 1024;
+    for width in [0, 1, 2, 31, 32, 33, 65, 137, 513] {
+        for height in [0, 1, 2, 15, 16, 17, 35, 137] {
+            if width == 0 || height == 0 {
+                continue;
+            }
+            for direction in [-1, 1] {
+                for (min_x, min_y) in [(1, 1), (3, 5)] {
+                    let region = Region {
+                        min_x,
+                        min_y,
+                        max_x: min_x + width,
+                        max_y: min_y + height,
+                        ..Region::default()
+                    };
+                    let nx = width as usize;
+                    let ny = height as usize;
+                    let bands = (nx - 1 + 2 * (ny - 1)) / BAND + 1;
+                    let row_bands = ny.div_ceil(SOURCE_ROWS);
+                    let mut sources = HashSet::new();
+                    for level in 0..bands + row_bands - 1 {
+                        let mut level_cells = HashSet::new();
+                        let mut plans = [Plan::default(); TILES];
+                        let mut count = 0;
+                        for band in level.saturating_sub(row_bands - 1)..=level.min(bands - 1) {
+                            let Some(plan) =
+                                Plan::new(region, stride, direction, band, level - band)
+                            else {
+                                continue;
+                            };
+                            let mut expected = HashSet::new();
+                            for (row, source) in plan.source.iter().enumerate() {
+                                for u in source.start..source.end {
+                                    let x = if direction > 0 {
+                                        min_x as usize + u
+                                    } else {
+                                        region.max_x as usize - u
+                                    };
+                                    let cell = (min_y as usize + plan.first_y + row) * stride + x;
+                                    assert!(sources.insert(cell));
+                                    let side = cell.wrapping_add_signed(direction as isize);
+                                    expected.extend([cell, side, cell + stride, side + stride]);
+                                }
+                            }
+                            let mut actual = HashSet::new();
+                            for row in 0..ROWS {
+                                for cell in plan.starts[row]..plan.starts[row] + plan.lengths[row] {
+                                    assert!(actual.insert(cell));
+                                    assert!(level_cells.insert(cell));
+                                }
+                            }
+                            assert_eq!(actual, expected);
+                            plans[count] = plan;
+                            count += 1;
+                            if count == TILES {
+                                ranges(&plans, count);
+                                count = 0;
+                            }
+                        }
+                        if count != 0 {
+                            ranges(&plans, count);
+                        }
+                    }
+                    assert_eq!(sources.len(), nx * ny);
+                }
+            }
+        }
+    }
+}
