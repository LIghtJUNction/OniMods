+//! Independent old-snapshot arithmetic for three same-gas pressure edges.
+use super::PressureMath;
+use core::arch::x86_64::{
+    _mm_cvtepi32_ps, _mm_cvttps_epi32, _mm_div_ps, _mm_loadu_ps, _mm_max_ps, _mm_min_ps,
+    _mm_mul_ps, _mm_set_ps, _mm_set1_ps, _mm_setr_epi32, _mm_setzero_ps, _mm_storeu_ps,
+    _mm_storeu_si128, _mm_sub_ps,
+};
+
+#[inline(always)]
+pub(super) fn calculate(
+    mass: f32,
+    neighbours: [f32; 3],
+    coefficient: f32,
+    count: i32,
+    neighbour_counts: [i32; 3],
+) -> [PressureMath; 3] {
+    let mut flows = [0.0_f32; 4];
+    // SAFETY: SSE2 is part of x86_64. The store targets four valid f32s.
+    // The spare lane computes only exact finite operations (0 / 1).
+    unsafe {
+        let a = _mm_set_ps(1.0, mass, mass, mass);
+        let b = _mm_set_ps(1.0, neighbours[2], neighbours[1], neighbours[0]);
+        let k = _mm_set_ps(0.0, coefficient, coefficient, coefficient);
+        let flow = _mm_max_ps(
+            _mm_min_ps(
+                _mm_mul_ps(k, _mm_sub_ps(a, b)),
+                _mm_mul_ps(_mm_set1_ps(0.125), a),
+            ),
+            _mm_mul_ps(_mm_set1_ps(-0.125), b),
+        );
+        _mm_storeu_ps(flows.as_mut_ptr(), flow);
+    }
+
+    let mut amounts = [0.0_f32; 4];
+    let mut old_masses = [1.0_f32; 4];
+    let mut counts = [0_i32; 4];
+    for lane in 0..3 {
+        if flows[lane] < 0.0 {
+            amounts[lane] = -flows[lane];
+            old_masses[lane] = neighbours[lane];
+            counts[lane] = neighbour_counts[lane];
+        } else {
+            amounts[lane] = flows[lane];
+            old_masses[lane] = mass;
+            counts[lane] = count;
+        }
+    }
+    let mut germs = [0_i32; 4];
+    // SAFETY: every load/store covers one complete four-element local array;
+    // unaligned SSE2 accesses do not require stack alignment beyond the arrays.
+    unsafe {
+        let old = _mm_loadu_ps(old_masses.as_ptr());
+        let amount = _mm_min_ps(_mm_loadu_ps(amounts.as_ptr()), old);
+        let fraction = _mm_max_ps(
+            _mm_min_ps(_mm_div_ps(amount, old), _mm_set1_ps(1.0)),
+            _mm_setzero_ps(),
+        );
+        let count = _mm_cvtepi32_ps(_mm_setr_epi32(counts[0], counts[1], counts[2], 0));
+        _mm_storeu_si128(
+            germs.as_mut_ptr().cast(),
+            _mm_cvttps_epi32(_mm_mul_ps(count, fraction)),
+        );
+    }
+    std::array::from_fn(|lane| PressureMath {
+        flow: flows[lane],
+        germs: germs[lane],
+    })
+}
