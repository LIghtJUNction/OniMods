+use super::*;
+use crate::fluid_helpers::{cvtt, smax, smin};
+use std::hint::black_box;
+
+#[derive(Clone, Copy, Debug)]
+struct Input {
+    mass: f32,
+    neighbours: [f32; 3],
+    coefficient: f32,
+    count: i32,
+    neighbour_counts: [i32; 3],
+}
+
+#[derive(Debug, PartialEq, Eq)]
+struct Observed {
+    flows: [u32; 3],
+    germs: [i32; 3],
+    environment: u32,
+}
+
+fn install(environment: u32) {
+    // SAFETY: tests pass only valid MXCSR controls and keep exceptions masked.
+    unsafe {
+        std::arch::asm!("ldmxcsr [{p}]", p = in(reg) &environment,
+            options(nostack, preserves_flags));
+    }
+}
+
+fn observe(values: [PressureMath; 3]) -> Observed {
+    let mut environment = 0_u32;
+    // SAFETY: the pointer covers one u32. Every computed value is an explicit
+    // dependency so neither conversion nor flow arithmetic can follow STMXCSR.
+    unsafe {
+        std::arch::asm!(
+            "/* {f0} {f1} {f2} {g0:e} {g1:e} {g2:e} */",
+            "stmxcsr [{p}]",
+            f0 = in(xmm_reg) values[0].flow,
+            f1 = in(xmm_reg) values[1].flow,
+            f2 = in(xmm_reg) values[2].flow,
+            g0 = in(reg) values[0].germs,
+            g1 = in(reg) values[1].germs,
+            g2 = in(reg) values[2].germs,
+            p = in(reg) &mut environment,
+            options(nostack, preserves_flags),
+        );
+    }
+    Observed {
+        flows: values.map(|value| value.flow.to_bits()),
+        germs: values.map(|value| value.germs),
+        environment,
+    }
+}
+
+#[inline(never)]
+fn original_edge(
+    mass: f32,
+    neighbour: f32,
+    coefficient: f32,
+    count: i32,
+    other: i32,
+) -> PressureMath {
+    // A call boundary prevents SLP from merging independent reference edges
+    // into DIVPS with unused 0/0 lanes, which would add spurious invalid flags.
+    let (mass, neighbour, coefficient, count, other) =
+        black_box((mass, neighbour, coefficient, count, other));
+    let flow = smax(
+        smin(coefficient * (mass - neighbour), 0.125 * mass),
+        -0.125 * neighbour,
+    );
+    let (amount, old_mass, count) = if flow < 0.0 {
+        (-flow, neighbour, other)
+    } else {
+        (flow, mass, count)
+    };
+    let amount = smin(amount, old_mass);
+    let fraction = smax(smin(amount / old_mass, 1.0), 0.0);
+    PressureMath {
+        flow,
+        germs: cvtt(count as f32 * fraction),
+    }
+}
+
+#[inline(never)]
+fn original(input: Input) -> Observed {
+    let input = black_box(input);
+    observe(std::array::from_fn(|lane| {
+        original_edge(
+            input.mass,
+            input.neighbours[lane],
+            input.coefficient,
+            input.count,
+            input.neighbour_counts[lane],
+        )
+    }))
+}
+
+#[inline(never)]
+fn packed(input: Input) -> Observed {
+    let input = black_box(input);
+    observe(calculate(
+        input.mass,
+        input.neighbours,
+        input.coefficient,
+        input.count,
+        input.neighbour_counts,
+    ))
+}
+
+fn compare(input: Input, environment: u32) {
+    install(environment);
+    let expected = original(input);
+    install(environment);
+    let actual = packed(input);
+    install(0x1f80);
+    assert_eq!(actual, expected, "input={input:?}, MXCSR={environment:#x}");
+}
+
+fn next(rng: &mut u32) -> u32 {
+    *rng ^= *rng << 13;
+    *rng ^= *rng >> 17;
+    *rng ^= *rng << 5;
+    *rng
+}
+
+#[test]
+fn pressure_triplet_preserves_words_germs_and_mxcsr_in_32_environments() {
+    let _restore = crate::float_env::FloatEnv::capture().install();
+    let words: [u32; 21] = [
+        0,
+        0x8000_0000,
+        1,
+        0x8000_0001,
+        0x007f_ffff,
+        0x0080_0000,
+        0x3c23_d70a,
+        0x3dcc_cccd,
+        0x3f00_0000,
+        0x3f80_0000,
+        0x4080_0000,
+        0xbf80_0000,
+        0x4eff_ffff,
+        0x4f00_0000,
+        0x7f7f_ffff,
+        0x7f80_0000,
+        0xff80_0000,
+        0x7fc0_1234,
+        0xffc0_5678,
+        0x7f80_0001,
+        0xff80_0001,
+    ];
+    let mut rng = 0x3141_5926;
+    let mut comparisons = 0;
+    for rounding in [0, 0x2000, 0x4000, 0x6000] {
+        for daz in [0, 0x40] {
+            for ftz in [0, 0x8000] {
+                for sticky in [0, 0x3f] {
+                    let environment = 0x1f80 | rounding | daz | ftz | sticky;
+                    for (a, &mass) in words.iter().enumerate() {
+                        for (b, &neighbour) in words.iter().enumerate() {
+                            for &coefficient in &words {
+                                compare(
+                                    Input {
+                                        mass: f32::from_bits(mass),
+                                        neighbours: [
+                                            f32::from_bits(neighbour),
+                                            f32::from_bits(words[(a + b + 1) % words.len()]),
+                                            f32::from_bits(words[(2 * a + b) % words.len()]),
+                                        ],
+                                        coefficient: f32::from_bits(coefficient),
+                                        count: next(&mut rng) as i32,
+                                        neighbour_counts: [i32::MAX, i32::MIN, 16_777_217],
+                                    },
+                                    environment,
+                                );
+                                comparisons += 3;
+                            }
+                        }
+                    }
+                    for _ in 0..10_000 {
+                        compare(
+                            Input {
+                                mass: f32::from_bits(next(&mut rng)),
+                                neighbours: std::array::from_fn(|_| f32::from_bits(next(&mut rng))),
+                                coefficient: f32::from_bits(next(&mut rng)),
+                                count: next(&mut rng) as i32,
+                                neighbour_counts: std::array::from_fn(|_| next(&mut rng) as i32),
+                            },
+                            environment,
+                        );
+                        comparisons += 3;
+                    }
+                }
+            }
+        }
+    }
+    eprintln!("CT_PRESSURE_CHECK edge_comparisons={comparisons}");
+}
