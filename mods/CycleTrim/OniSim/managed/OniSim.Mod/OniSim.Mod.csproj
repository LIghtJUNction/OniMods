<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>OniSim.Mod</AssemblyName>
    <RootNamespace>OniSim.CycleTrim</RootNamespace>
    <OniSimGameAssemblyPath Condition="'$(OniSimGameAssemblyPath)' == ''">$(OniManagedPath)/Assembly-CSharp.dll</OniSimGameAssemblyPath>
    <OniSimHarmonyPath Condition="'$(OniSimHarmonyPath)' == ''">$(OniManagedPath)/0Harmony.dll</OniSimHarmonyPath>
  </PropertyGroup>
  <ItemGroup>
    <None Update="mod.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="mod_info.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Assembly-CSharp">
      <HintPath>$(OniSimGameAssemblyPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(OniSimHarmonyPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateOfficialReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(OniSimGameAssemblyPath)')" Text="Supply the official Assembly-CSharp.dll with OniSimGameAssemblyPath." />
    <Error Condition="!Exists('$(OniSimHarmonyPath)')" Text="Supply the game's Harmony reference with OniSimHarmonyPath." />
  </Target>
</Project>
