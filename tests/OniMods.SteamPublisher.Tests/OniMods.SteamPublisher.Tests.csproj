<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OniGamePath Condition="'$(OniGamePath)' == ''">$(HOME)/.local/share/Steam/steamapps/common/OxygenNotIncluded</OniGamePath>
    <OniManagedPath Condition="'$(OniManagedPath)' == ''">$(OniGamePath)/OxygenNotIncluded_Data/Managed</OniManagedPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../tools/OniMods.SteamPublisher/OniMods.SteamPublisher.csproj" />
    <Reference Include="Steamworks.NET">
      <HintPath>$(OniManagedPath)/com.rlabrecque.steamworks.net.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
