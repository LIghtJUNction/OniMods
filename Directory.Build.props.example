<Project>

  <!--
    复制为 Directory.Build.props，并把 OniGamePath 设置为本机缺氧安装目录。
    也可以运行 `onim setup` 自动生成；该命令会按当前平台生成 OniManagedPath。
    手工配置 macOS 时，Managed 目录是：
    $(OniGamePath)/OxygenNotIncluded.app/Contents/Resources/Data/Managed
  -->

  <PropertyGroup>
    <OniGamePath></OniGamePath>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Windows/Linux 默认布局；macOS 请使用上方注明的 .app/Contents/Resources/Data/Managed 路径。 -->
    <OniManagedPath>$(OniGamePath)/OxygenNotIncluded_Data/Managed</OniManagedPath>
  </PropertyGroup>

  <Target Name="ValidateOniGamePath" BeforeTargets="BeforeBuild">
    <Error Text="游戏路径未配置！请复制 Directory.Build.props.example 为 Directory.Build.props，并设置 OniGamePath。" Condition="'$(OniGamePath)' == ''" />
  </Target>

</Project>
