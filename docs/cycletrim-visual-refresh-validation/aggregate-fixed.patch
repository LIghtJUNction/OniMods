+            // Each reader contains only the original field loads, in order.
+            // Keep the groups separate so no load crosses a null check or the
+            // live camera/world queries, which can invoke another mod's code.
+            private static OwnersReader CreateOwnersReader()
+            {
+                var instance = Linq.Expression.Parameter(typeof(ConduitFlowVisualizer), "instance");
+                var tuning = Output<ConduitFlowVisualizer.Tuning>("tuning");
+                var style = Output<Game.ConduitVisInfo>("style");
+                var moving = Output<object>("moving");
+                var stationary = Output<object>("stationary");
+                return Linq.Expression.Lambda<OwnersReader>(Linq.Expression.Block(
+                    Linq.Expression.Assign(tuning, Field(instance, "tuning")),
+                    Linq.Expression.Assign(style, Field(instance, "visInfo")),
+                    Linq.Expression.Assign(moving, Field(instance, "movingBallMesh")),
+                    Linq.Expression.Assign(stationary, Field(instance, "staticBallMesh")),
+                    Linq.Expression.Empty()), instance, tuning, style, moving, stationary).Compile();
+            }
+
+            private static ResourcesReader CreateResourcesReader(Type meshType)
+            {
+                var moving = Linq.Expression.Parameter(typeof(object), "moving");
+                var stationary = Linq.Expression.Parameter(typeof(object), "stationary");
+                var movingMesh = Output<Mesh>("movingMesh");
+                var staticMesh = Output<Mesh>("staticMesh");
+                var movingMaterial = Output<Material>("movingMaterial");
+                var staticMaterial = Output<Material>("staticMaterial");
+                var movingValue = Linq.Expression.Convert(moving, meshType);
+                var staticValue = Linq.Expression.Convert(stationary, meshType);
+                return Linq.Expression.Lambda<ResourcesReader>(Linq.Expression.Block(
+                    Linq.Expression.Assign(movingMesh, Field(movingValue, "mesh")),
+                    Linq.Expression.Assign(staticMesh, Field(staticValue, "mesh")),
+                    Linq.Expression.Assign(movingMaterial, Field(movingValue, "material")),
+                    Linq.Expression.Assign(staticMaterial, Field(staticValue, "material")),
+                    Linq.Expression.Empty()), moving, stationary, movingMesh, staticMesh,
+                    movingMaterial, staticMaterial).Compile();
+            }
+
+            private static ControlsReader CreateControlsReader()
+            {
+                var instance = Linq.Expression.Parameter(typeof(ConduitFlowVisualizer), "instance");
+                var layer = Output<int>("layer");
+                var highlightedCell = Output<int>("highlightedCell");
+                var highlightColour = Output<Color32>("highlightColour");
+                var flow = Output<ConduitFlow>("flow");
+                return Linq.Expression.Lambda<ControlsReader>(Linq.Expression.Block(
+                    Linq.Expression.Assign(layer, Field(instance, "layer")),
+                    Linq.Expression.Assign(highlightedCell, Field(instance, "highlightedCell")),
+                    Linq.Expression.Assign(highlightColour, Field(instance, "highlightColour")),
+                    Linq.Expression.Assign(flow, Field(instance, "flowManager")),
+                    Linq.Expression.Empty()), instance, layer, highlightedCell, highlightColour, flow).Compile();
+            }
+
+            private static Linq.ParameterExpression Output<T>(string name)
+            {
+                return Linq.Expression.Parameter(typeof(T).MakeByRefType(), name);
+            }
+
